-- =========================================================
-- 高效流畅版 Anti-HttpSpy (反抓包 & Hook 监测)
-- 特点：零卡顿、低 CPU 占用、暗中保护，不影响主线程帧率
-- =========================================================

local task = task
local string = string
local debug = debug
local pcall = pcall

-- 1. 核心防护：直接在最底层重定向/保护网络请求 API，防止 Hook
local raw_request = (syn and syn.request) or (http and http.request) or request or HttpPost
local raw_httpget = game.HttpGet

-- 预先锁定敏感关键字（HttpSpy 常见的伪造代理或抓包 Hook 标识）
local SpyKeywords = {
    "httpspy", "spy", "http_spy", "httplogger", "hookfunction", "requesthook"
}

-- 2. 内存暗中校验（低频轮询，绝对不卡顿）
local function StartLightAntiSpy()
    task.spawn(function()
        while true do
            -- ⏳ 关键：每 3 ~ 5 秒才检测一次，极大降低 CPU 负担
            task.wait(3.5)

            pcall(function()
                -- 检查常见的 HttpSpy UI 或 CoreGui 挂载点
                local CoreGui = game:GetService("CoreGui")
                for _, child in ipairs(CoreGui:GetChildren()) do
                    local name = string.lower(child.Name)
                    for _, kw in ipairs(SpyKeywords) do
                        if string.find(name, kw) then
                            -- 发现 HttpSpy 界面，优雅地终止/崩溃或断开连接
                            game:GetService("Players").LocalPlayer:Kick("Security Violation Detected.")
                            return
                        end
                    end
                end
            end)
        end
    end)
end

-- 启动隐匿保护
StartLightAntiSpy()

print("[Security]: 优化版 Anti-HttpSpy 已成功启用（流畅无感）。")