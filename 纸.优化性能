-- =========================================================
-- 秒踢版 Anti-HttpSpy (检测到直接 Kick 玩家)
-- 特点：零卡顿、极低 CPU 占用、检测即瞬间踢出
-- =========================================================

local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

-- 1. Kick 执行函数 (附带明确提示)
local function KickPlayer(reason)
    pcall(function()
        LocalPlayer:Kick("\n[安全系统告警]\n检测到非法抓包/调试工具 (" .. (reason or "HttpSpy") .. ")\n请关闭抓包工具后重新进入游戏。")
    end)
    -- 强制中断当前脚本线程，防止后续代码继续被窃取
    task.wait(9e9)
end

-- 2. HttpSpy 常见 UI / 标识关键字匹配表
local SpyKeywords = {
    "httpspy", "http_spy", "httplogger", "spy", 
    "reqhook", "hookfunction", "packetlog"
}

-- 3. 暗中巡逻线程 (3秒一次，完全不卡顿)
task.spawn(function()
    while true do
        task.wait(3) -- ⏳ 3秒检测一次，掉帧率彻底为 0

        pcall(function()
            -- A. 检查 CoreGui 界面层（HttpSpy 界面通常挂载在这里）
            for _, child in ipairs(CoreGui:GetChildren()) do
                local name = string.lower(child.Name)
                for _, kw in ipairs(SpyKeywords) do
                    if string.find(name, kw) then
                        KickPlayer("HttpSpy UI: " .. child.Name)
                        return
                    end
                end
            end

            -- B. 检查全局环境标识 (HttpSpy 注入时留下的全局变量)
            if getgenv then
                local genv = getgenv()
                if genv.HttpSpy or genv.SpyInstalled or genv.HookedRequests or genv.httpspy then
                    KickPlayer("HttpSpy Environment Variable")
                    return
                end
            end
            
            -- C. 检查 Hook 签名（防止 game.HttpGet 被替换）
            local httpGetStr = tostring(game.HttpGet)
            if not string.find(httpGetStr, "HttpGet") and not string.find(httpGetStr, "function") then
                KickPlayer("HttpGet Hooked")
                return
            end
        end)
    end
end)

print("[Security]: 强力秒踢版 Anti-HttpSpy 已成功加载（流畅无感）。")