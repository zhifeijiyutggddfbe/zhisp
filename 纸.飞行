local INK = Color3.fromRGB(32, 36, 46)
local GLASS = Color3.fromRGB(255, 255, 255)

local function glassify(obj, radius, bgTrans, strokeTrans, bgColor)
	obj.BorderSizePixel = 0
	obj.BackgroundColor3 = bgColor or GLASS
	obj.BackgroundTransparency = bgTrans
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = obj
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Transparency = strokeTrans
	stroke.Thickness = 1
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = obj
	return corner, stroke
end

