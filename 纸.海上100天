local function openFlightPanel()
  local main = Instance.new("ScreenGui")
  local Frame = Instance.new("Frame")
  local up = Instance.new("TextButton")
  local down = Instance.new("TextButton")
  local onof = Instance.new("TextButton")
  local TextLabel = Instance.new("TextLabel")
  local plus = Instance.new("TextButton")
  local speedLbl = Instance.new("TextLabel")
  local mine = Instance.new("TextButton")
  local closebutton = Instance.new("TextButton")
  local mini = Instance.new("TextButton")
  local mini2 = Instance.new("TextButton")

  local GLASS_TRANSPARENCY = 0.78
  local GRAD_BLUE  = Color3.fromRGB(18, 20, 85)
  local GRAD_PURPLE = Color3.fromRGB(78, 20, 130)
  local STROKE_COLOR = Color3.fromRGB(140, 100, 255)

  local function makeGlass(gui, transparency)
    gui.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    gui.BackgroundTransparency = transparency or GLASS_TRANSPARENCY
    gui.BorderSizePixel = 0
    gui.BorderColor3 = Color3.fromRGB(255, 255, 255)

    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new({
      ColorSequenceKeypoint.new(0, GRAD_BLUE),
      ColorSequenceKeypoint.new(1, GRAD_PURPLE),
    })
    grad.Rotation = 45
    grad.Parent = gui

    local stroke = Instance.new("UIStroke")
    stroke.Name = "GlassStroke"
    stroke.Color = STROKE_COLOR
    stroke.Thickness = 1.5
    stroke.Transparency = 0.65
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = gui

    if gui:IsA("TextButton") or gui:IsA("TextLabel") then
      gui.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
  end

  main.Name = "zhiFlightPanel"
