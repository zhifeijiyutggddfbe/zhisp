ESPTab:AddToggle("启用透视", false, function(state)
  espEnabled = state

  if state then
    UpdateESP()

    if connect4 then connect4:Disconnect() end
    connect4 = runService.Heartbeat:Connect(function()
      if espEnabled and espPatterns and #espPatterns > 0 then
        local debrisField = workspace:FindFirstChild("DebrisField")
        if debrisField then
          for _, folder in pairs(debrisField:GetChildren()) do
            if folder:IsA("Folder") or folder:IsA("Model") then
              for _, part in pairs(folder:GetChildren()) do
                if part:IsA("BasePart") then
                  for _, pat in pairs(espPatterns) do
                    if string.find(part.Name, pat) == 1 and not espObjects[part] then
                      espObjects[part] = f14(part)
                      break
                    end
                  end
                end
              end
            end
          end
        end
      end
    end)

    zhiUI:Notify("透视已启用", "透视已开启", 2)
  else
    clearESP()
    if connect4 then
      connect4:Disconnect()
      connect4 = nil
    end
    zhiUI:Notify("透视已禁用", "透视已关闭", 1.5)
  end
end)

