local espPatterns = { "BrokenCrate" }
local espEnabled = false
local espObjects = {}

local function f14(part)
  if not part or not part:IsA("BasePart") then return end

  local highlight = Instance.new("Highlight")
  highlight.Adornee = part
  highlight.FillColor = Color3.new(0, 1, 0)
  highlight.FillTransparency = 0.4
  highlight.OutlineColor = Color3.new(0, 1, 0)
  highlight.OutlineTransparency = 0
  highlight.Parent = part

  local bb = Instance.new("BillboardGui")
  bb.Adornee = part
  bb.Size = UDim2.new(0, 100, 0, 30)
  bb.StudsOffset = Vector3.new(0, 3, 0)
  bb.Parent = part

  local lbl = Instance.new("TextLabel")
  lbl.Size = UDim2.new(1, 0, 1, 0)
  lbl.BackgroundTransparency = 1
  lbl.Text = part.Name
  lbl.TextColor3 = Color3.new(1, 1, 1)
  lbl.TextScaled = true
  lbl.Font = Enum.Font.GothamBold
  lbl.Parent = bb

  return { Highlight = highlight, Billboard = bb, TextLabel = lbl }
end

local function f15(part)
  if espObjects[part] then
    local o = espObjects[part]
    if o.Highlight then o.Highlight:Destroy() end
    if o.Billboard then o.Billboard:Destroy() end
    espObjects[part] = nil
  end
end

local function clearESP()
  local keys = {}
  for k in pairs(espObjects) do table.insert(keys, k) end
  for _, k in ipairs(keys) do f15(k) end
end

local function UpdateESP()
  clearESP()
  if not espEnabled or not espPatterns or #espPatterns == 0 then return end

  local debrisField = workspace:FindFirstChild("DebrisField")
  if not debrisField then return end

  local count = 0
  for _, folder in pairs(debrisField:GetChildren()) do
    if folder:IsA("Folder") or folder:IsA("Model") then
      for _, part in pairs(folder:GetChildren()) do
        if part:IsA("BasePart") then
          for _, pat in pairs(espPatterns) do
            if string.find(part.Name, pat) == 1 then
              if not espObjects[part] then
                espObjects[part] = f14(part)
                count = count + 1
              end
              break
            end
          end
        end
      end
    end
  end

  if count > 0 then
    zhiUI:Notify("透视已更新", "正在高亮 " .. count .. " 个物品", 2)
  else
    zhiUI:Notify("未找到物品", "未找到要高亮的物品", 2)
  end
end

