local Stats = {
	leavesCollected = 0,
	totalMoney = 0,
	sessionTime = 0,
	startTime = tick(),
	lastCollectTime = tick(),
	lastSellTime = 0,
	failureCount = 0,
	sellCount = 0,
	maxFailures = 10,
}

local function formatNumber(num)
	if num >= 1000000 then
		return string.format("%.2fM", num / 1000000)
	elseif num >= 1000 then
		return string.format("%.2fK", num / 1000)
	else
		return tostring(math.floor(num))
	end
end

local function getStats()
	Stats.sessionTime = tick() - Stats.startTime
	local rate = Stats.sessionTime > 0 and (Stats.leavesCollected / Stats.sessionTime) or 0
	return {
		leaves = formatNumber(Stats.leavesCollected),
		rate = string.format("%.1f/s", rate),
		time = string.format("%02d:%02d", math.floor(Stats.sessionTime / 60), math.floor(Stats.sessionTime % 60)),
		failures = Stats.failureCount,
		sells = Stats.sellCount
	}
end

-- ==================== 日志系统 ====================
local LogBuffer = {}
local maxLogs = 50

local function addLog(message)
	local timestamp = os.date("%H:%M:%S")
	local logMsg = "[" .. timestamp .. "] " .. message
	table.insert(LogBuffer, 1, logMsg)
	if #LogBuffer > maxLogs then
		table.remove(LogBuffer, maxLogs + 1)
	end
end

