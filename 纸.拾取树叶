-- ==================== 背包判断 ====================
local function isBagFull()
	if infiniteBagMode then return false end

	local leaves = LocalPlayer:GetAttribute("Leaves")
	local capacity = LocalPlayer:GetAttribute("LeafCapacity")

	if leaves and capacity then
		return tonumber(leaves) >= tonumber(capacity) * 0.95 -- 95% 时出售
	end

	return false
end

local function getBagInfo()
	local leaves = LocalPlayer:GetAttribute("Leaves") or 0
	local capacity = LocalPlayer:GetAttribute("LeafCapacity") or 0
	return leaves, capacity
end

-- ==================== 飞行系统（改进） ====================
local function flyTo(position)
	if not hrpCache or not hrpCache.Parent then return false end

	local distance = (position - hrpCache.Position).Magnitude
	local duration = math.max(0.1, distance / flySpeed)

	if duration < 0.05 then
		hrpCache.CFrame = CFrame.new(position)
		return true
	end

	if currentTween then
		currentTween:Cancel()
		currentTween = nil
	end

	local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	currentTween = TweenService:Create(hrpCache, tweenInfo, { CFrame = CFrame.new(position) })

	currentTween:Play()

	local success = pcall(function()
		currentTween.Completed:Wait()
	end)

	currentTween = nil
	return success
end

-- ==================== 智能收集系统 ====================
local function smartFlyPattern()
	if not hrpCache then return end

	-- 8字形飞行模式，覆盖更大范围
	local basePos = hrpCache.Position
	local pattern = {
		basePos + Vector3.new(20, 10, 0),
		basePos + Vector3.new(-20, 10, 0),
		basePos + Vector3.new(0, 10, 20),
		basePos + Vector3.new(0, 10, -20),
	}

	for _, pos in ipairs(pattern) do
		if autoFarmEnabled and not isSelling then
			flyTo(pos)
			task.wait(0.1)
		end
	end
end

-- ==================== 出售系统（改进） ====================
local function sellLeavesProcess()
	if isSelling or not autoFarmEnabled then return end
	isSelling = true

	if currentTween then
		currentTween:Cancel()
		currentTween = nil
	end

	local leaves, capacity = getBagInfo()
	addLog("开始出售: " .. leaves .. "/" .. capacity)

	flyTo(sellPos)
	task.wait(0.3)

	pcall(function()
		ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("EmptyBackpack"):FireServer()
	end)

	task.wait(0.4)

	if autoUpgradeBagEnabled then
		buyBagUpgrade()
		task.wait(0.1)
	end

	if autoBuyToolsEnabled then
		buyTool("LeafBlower")
		task.wait(0.05)
		buyTool("Rake")
		task.wait(0.05)
	end

	table.clear(collectHistory) -- 修复：出售期间没有收集是正常现象，不应触发卡顿检测
	Stats.leavesCollected += leaves
	lastSellTime = tick()
	addLog("出售完成: +" .. leaves .. " 树叶")
	zhiUI:Notify("出售完成", "+" .. leaves .. " 树叶", 2.5)
	isSelling = false
end

local function checkAttributeAndSell()
	if autoFarmEnabled and not infiniteBagMode and not isSelling then
		if isBagFull() then
			task.spawn(sellLeavesProcess)
		end
	end
end

leafConnections[#leafConnections + 1] = LocalPlayer:GetAttributeChangedSignal("Leaves"):Connect(checkAttributeAndSell)
leafConnections[#leafConnections + 1] = LocalPlayer:GetAttributeChangedSignal("LeafCapacity"):Connect(checkAttributeAndSell)

-- ==================== 寻找最近树叶 ====================
local function findNearestLeaf()
	if not hrpCache then return nil, math.huge end
	local myPos = hrpCache.Position
	local nearestLeaf = nil
	local nearestDist = math.huge
	local toRemove = {}

	for leaf, _ in pairs(leafCache) do
		if isValidLeaf(leaf) then
			local dist = (leaf.Position - myPos).Magnitude
			if dist < nearestDist then
				nearestDist = dist
				nearestLeaf = leaf
			end
		else
			table.insert(toRemove, leaf)
		end
	end

	for _, leaf in ipairs(toRemove) do
		leafCache[leaf] = nil
	end

	if nearestLeaf == nil then
		scanAllLeaves()
	end

	return nearestLeaf, nearestDist
end

-- ==================== 范围收集（改进） ====================
local function collectNearbyLeaves(radius)
	if not hrpCache or not LeafSim then return 0 end
	local myPos = hrpCache.Position
	local collected = 0
	local toRemove = {}

	for leaf, _ in pairs(leafCache) do
		if isValidLeaf(leaf) then
			if (leaf.Position - myPos).Magnitude <= radius then
				pcall(function()
					LeafSim.collect(leaf)
					table.insert(toRemove, leaf)
					collected += 1
					pushCollectHistory() -- 修复：使用带长度限制的写入函数

					if collected % 20 == 0 then
						task.wait()
					end
				end)
			end
		else
			table.insert(toRemove, leaf)
		end
	end

	for _, leaf in ipairs(toRemove) do
		leafCache[leaf] = nil
	end

	return collected
end

-- ==================== 主循环系统 ====================
local function startMainAutoLoop()
	if autoFarmEnabled then return end
	autoFarmEnabled = true
	isPaused = false
	isSelling = false
	Stats.startTime = tick()
	Stats.leavesCollected = 0
	table.clear(collectHistory)

	addLog("启动自动挂机...")
	checkAttributeAndSell()

	workerThread = task.spawn(function()
		while autoFarmEnabled do
			if isPaused then
				task.wait(0.5)
				continue
			end

			if detectStuck() then
				recoveryFromStuck()
				continue
			end

			if isSelling then
				task.wait(0.2)
				continue
			end

			if isBagFull() then
				sellLeavesProcess()
				task.wait(0.2)
				continue
			end

			if useFlyToLeaf then
				local nearestLeaf, dist = findNearestLeaf()
				if nearestLeaf then
					flyTo(nearestLeaf.Position + Vector3.new(0, 3, 0))

					if not isSelling then
						local collected = collectNearbyLeaves(collectionRadius)
						if collected == 0 and useSmartCollection then
							smartFlyPattern()
						end
					end
					task.wait(0.05)
				else
					scanAllLeaves()
					if useSmartCollection then
						smartFlyPattern()
					end
					task.wait(0.3)
				end
			else
				local processed = 0
				local toRemove = {}

				for leaf, _ in pairs(leafCache) do
					if not autoFarmEnabled or isSelling or isPaused then break end
					if isValidLeaf(leaf) then
						pcall(function()
							LeafSim.collect(leaf)
							pushCollectHistory() -- 修复：使用带长度限制的写入函数
						end)
						table.insert(toRemove, leaf)
						processed += 1

						if processed >= 30 then
							processed = 0
							task.wait()
						end
					else
						table.insert(toRemove, leaf)
					end
				end

				for _, leaf in ipairs(toRemove) do
					leafCache[leaf] = nil
				end

				if processed == 0 then
					scanAllLeaves()
				end

				task.wait(0.05)
			end
		end
	end)
end

local function stopMainAutoLoop()
	autoFarmEnabled = false
	isPaused = false
	isSelling = false

	if currentTween then
		currentTween:Cancel()
		currentTween = nil
	end

	if workerThread then
		task.cancel(workerThread)
		workerThread = nil
	end

	addLog("已停止自动挂机")
end

