local Players           = game:GetService("Players")
local Workspace         = game:GetService("Workspace")
local RunService        = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
if not LocalPlayer then return end

local UI_URL = "https://raw.githubusercontent.com/yda66722-hash/zhiUI/refs/heads/main/zhiUI"
local zhiUI
do
	local ok, lib = pcall(function()
		return loadstring(game:HttpGet(UI_URL))()
	end)
	if not ok or type(lib) ~= "table" or type(lib.CreateWindow) ~= "function" then
		warn("[LeafFarm] zhiUI load failed")
		return
	end
	zhiUI = lib
end

local PlayerScripts = LocalPlayer:WaitForChild("PlayerScripts")
local LeafSim
do
	local m = PlayerScripts:WaitForChild("LeafSim", 20)
	if m then
		local ok, r = pcall(require, m)
		if ok and type(r) == "table" and type(r.collect) == "function" then
			LeafSim = r
		end
	end
end
if not LeafSim then
	warn("[LeafFarm] LeafSim not loaded")
	return
end

local FlySpeed       = 120
local FlyTimeout     = 12
local ArriveDist     = 3
local CollectRadius  = 22
local FailCooldown   = 0.8
local MaxJumpPerTick = 40
local TrashPos       = Vector3.new(54.24, 65.29, -50.26)
local TrashOffset    = Vector3.new(0, 3, 0)

local running        = true
local autoTrash      = true
local noclip         = true
local autoBuyRake    = false
local autoBuyMolotov = false
local autoBuyBlower  = false
local autoBuyBag     = false
local collectedTotal = 0
local cooldowns      = setmetatable({}, { __mode = "k" })

local function getLeavesFolder()
	local f = Workspace:FindFirstChild("Leaves")
	if f and f:IsA("Folder") then return f end
	return nil
end

local function getHRP()
	local c = LocalPlayer.Character
	if not c or not c.Parent then return nil end
	local r = c:FindFirstChild("HumanoidRootPart")
	if r and r:IsA("BasePart") then return r end
	return nil
end

local function isAlive()
	local c = LocalPlayer.Character
	if not c or not c.Parent then return false end
	local h = c:FindFirstChildOfClass("Humanoid")
	return h ~= nil and h.Health > 0 and getHRP() ~= nil
end

local function isValidLeaf(leaf)
	if not leaf or not leaf.Parent then return false end
	local ok = pcall(function() return leaf:IsA("BasePart") end)
	if not ok or not leaf:IsA("BasePart") then return false end
	if leaf.CanQuery == false then return false end
	if leaf.Transparency >= 0.9 then return false end
	return true
end

local function tryCollect(leaf)
	if not isValidLeaf(leaf) then return false end
	local cd = cooldowns[leaf]
	if cd and os.clock() < cd then return false end

	local ok, res = pcall(LeafSim.collect, leaf)
	if ok and res == true then
		collectedTotal = collectedTotal + 1
		cooldowns[leaf] = nil
		return true
	end
	cooldowns[leaf] = os.clock() + FailCooldown
	return false
end

local function isBagFull()
	local leaves = LocalPlayer:GetAttribute("Leaves")
	local cap    = LocalPlayer:GetAttribute("LeafCapacity")
	if type(leaves) ~= "number" or type(cap) ~= "number" then return false end
	return leaves >= cap
end

local function setCharacterCollide(state)
	local c = LocalPlayer.Character
	if not c or not c.Parent then return end
	for _, d in ipairs(c:GetDescendants()) do
		if d:IsA("BasePart") then
			pcall(function() d.CanCollide = state end)
		end
	end
end

local function flyTo(targetPos, speed, abortOnFull)
	speed = speed or FlySpeed
	local deadline = os.clock() + FlyTimeout

	if noclip then setCharacterCollide(false) end

	local result = false

	while running do
		if abortOnFull and isBagFull() then
			result = "full"
			break
		end

		local dt = RunService.Heartbeat:Wait()
		if os.clock() > deadline then
			result = false
			break
		end

		local hrp = getHRP()
		if not hrp then
			result = false
			break
		end

		local cur   = hrp.Position
		local delta = targetPos - cur
		local dist  = delta.Magnitude

		if dist <= ArriveDist then
			result = true
			break
		end

		local step = math.min(speed * dt, dist)
		local dir  = delta / dist
		local newPos = cur + dir * step

		local cf = hrp.CFrame
		hrp.CFrame = CFrame.new(newPos) * (cf - cf.Position)
		hrp.AssemblyLinearVelocity  = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end

	if noclip then
		task.delay(0.1, function()
			setCharacterCollide(true)
		end)
	end

	return result
end

local function findNearestLeaf()
	local folder = getLeavesFolder()
	if not folder then return nil end
	local hrp = getHRP()
	if not hrp then return nil end

	local ok, children = pcall(function() return folder:GetChildren() end)
	if not ok or type(children) ~= "table" then return nil end

	local bestLeaf, bestDist = nil, math.huge
	local rp = hrp.Position
	for _, leaf in ipairs(children) do
		if isValidLeaf(leaf) then
			local okP, lp = pcall(function() return leaf.Position end)
			if okP and lp then
				local d = (lp - rp).Magnitude
				if d < bestDist then
					bestDist = d
					bestLeaf = leaf
				end
			end
		end
	end
	return bestLeaf
end

local function getRemotes()
	return ReplicatedStorage:FindFirstChild("Remotes")
end

local function fireEmptyBackpack()
	local remotes = getRemotes()
	if not remotes then return false end
	local evt = remotes:FindFirstChild("EmptyBackpack")
	if not evt or not evt:IsA("RemoteEvent") then return false end
	local ok = pcall(function() evt:FireServer() end)
	return ok
end

local function goToTrashAndEmpty()
	local target = TrashPos + TrashOffset
	local r = flyTo(target, FlySpeed, false)
	if r ~= true then return false end

	fireEmptyBackpack()

	local t0 = os.clock()
	while os.clock() - t0 < 2.5 do
		if not isBagFull() then return true end
		task.wait(0.08)
	end
	return true
end

local function getToolsToBuy()
	local map = Workspace:FindFirstChild("Map")
	if not map then return nil end
	return map:FindFirstChild("ToolsToBuy")
end

local function buyToolCash(toolName, targetName)
	local remotes = getRemotes()
	if not remotes then return false, "no Remotes" end
	local evt = remotes:FindFirstChild("BuyToolCash")
	if not evt or not evt:IsA("RemoteEvent") then return false, "no BuyToolCash" end

	local ttb = getToolsToBuy()
	if not ttb then return false, "no ToolsToBuy" end

	local target = ttb:FindFirstChild(targetName or toolName)
	if not target then return false, "no " .. tostring(targetName or toolName) end

	local ok = pcall(function() evt:FireServer(toolName, target) end)
	return ok
end

local function buyBagUpgrade()
	local remotes = getRemotes()
	if not remotes then return false, "no Remotes" end
	local evt = remotes:FindFirstChild("BuyBagUpgrade")
	if not evt or not evt:IsA("RemoteEvent") then return false, "no BuyBagUpgrade" end

	local ttb = getToolsToBuy()
	if not ttb then return false, "no ToolsToBuy" end

	local bag = ttb:FindFirstChild("BagUpgrade")
	if not bag then return false, "no BagUpgrade" end

	local ok = pcall(function() evt:FireServer(bag) end)
	return ok
end

local function buyRake()     return buyToolCash("Rake") end
local function buyMolotov()  return buyToolCash("Molotov") end
local function buyBlower()   return buyToolCash("LeafBlower", "Leaf Blower") end

local function collectAround(centerPos, radius)
	local folder = getLeavesFolder()
	if not folder then return 0 end
	local ok, children = pcall(function() return folder:GetChildren() end)
	if not ok or type(children) ~= "table" then return 0 end

	local n = 0
	for _, l in ipairs(children) do
		if n >= MaxJumpPerTick then break end
		if isValidLeaf(l) and not (cooldowns[l] and os.clock() < cooldowns[l]) then
			local okP, lp = pcall(function() return l.Position end)
			if okP and lp and (lp - centerPos).Magnitude <= radius then
				if tryCollect(l) then n = n + 1 end
			end
		end
	end
	return n
end

local function tick()
	if not running then return end
	if not isAlive() then task.wait(0.2) return end

	if autoTrash and isBagFull() then
		goToTrashAndEmpty()
		return
	end

	local leaf = findNearestLeaf()
	if not leaf then
		task.wait(0.15)
		return
	end

	local okP, lp = pcall(function() return leaf.Position end)
	if not okP or not lp then return end

	local result = flyTo(lp + Vector3.new(0, 2, 0), FlySpeed, true)

	if result == "full" then return end
	if result ~= true then
		cooldowns[leaf] = os.clock() + FailCooldown
		return
	end

	tryCollect(leaf)

	local hrp = getHRP()
	if hrp then
		collectAround(hrp.Position, CollectRadius)
	end

	task.wait(0.04)
end

task.spawn(function()
	while true do
		if running then
			pcall(tick)
		end
		task.wait(0.03)
	end
end)

local hookedFolders = setmetatable({}, { __mode = "k" })
local function hookFolder(folder)
	if not folder or hookedFolders[folder] then return end
	hookedFolders[folder] = true
	pcall(function()
		folder.ChildAdded:Connect(function(child)
			if not running or (autoTrash and isBagFull()) then return end
			task.delay(0.05, function()
				if running and isValidLeaf(child) then
					tryCollect(child)
				end
			end)
		end)
	end)
end

task.spawn(function()
	while true do
		local f = getLeavesFolder()
		if f then hookFolder(f) end
		task.wait(1.5)
	end
end)

task.spawn(function()
	while true do
		task.wait(4)
		if autoBuyRake    then pcall(buyRake) end
		if autoBuyMolotov then pcall(buyMolotov) end
		if autoBuyBlower  then pcall(buyBlower) end
		if autoBuyBag     then pcall(buyBagUpgrade) end
	end
end)

