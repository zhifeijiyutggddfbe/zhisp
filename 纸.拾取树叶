-- ==================== 背包判断 ====================
local function isBagFull()
	if infiniteBagMode then return false end

	local leaves = LocalPlayer:GetAttribute("Leaves")
	local capacity = LocalPlayer:GetAttribute("LeafCapacity")

	if leaves and capacity then
		return tonumber(leaves) >= tonumber(capacity) * 0.95
	end

	return false
end

local function getBagInfo()
	local leaves = LocalPlayer:GetAttribute("Leaves") or 0
	local capacity = LocalPlayer:GetAttribute("LeafCapacity") or 0
	return leaves, capacity
end

-- ==================== 飞行系统 ====================
local function flyTo(position)
	if not hrpCache or not hrpCache.Parent then return false end
	
	local distance = (position - hrpCache.Position).Magnitude
	local duration = math.max(0.1, distance / flySpeed)

	if duration < 0.05 then
		hrpCache.CFrame = CFrame.new(position)
		return true
	end

	if currentTween then
		currentTween:Cancel()
		currentTween = nil
	end

	local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	currentTween = TweenService:Create(hrpCache, tweenInfo, { CFrame = CFrame.new(position) })
	
	currentTween:Play()
	
	local success = pcall(function()
		currentTween.Completed:Wait()
	end)
	
	currentTween = nil
	return success
end

-- ==================== 智能收集系统 ====================
local function smartFlyPattern()
	if not hrpCache then return end
	
	local basePos = hrpCache.Position
	local pattern = {
		basePos + Vector3.new(20, 10, 0),
		basePos + Vector3.new(-20, 10, 0),
		basePos + Vector3.new(0, 10, 20),
		basePos + Vector3.new(0, 10, -20),
	}
	
	for _, pos in ipairs(pattern) do
		if autoFarmEnabled and not sellState.isSelling then
			flyTo(pos)
			task.wait(0.1)
		end
	end
end

-- ==================== 出售系统 ====================
local function sellLeavesProcess()
	if sellState.isSelling or not autoFarmEnabled then 
		return 
	end
	
	sellState.isSelling = true
	sellState.sellStartTime = tick()
	sellState.consecutiveFailures += 1

	if currentTween then
		currentTween:Cancel()
		currentTween = nil
	end

	local leaves, capacity = getBagInfo()
	addLog("开始出售: " .. leaves .. "/" .. capacity)

	local flySuccess = flyTo(sellPos)
	if not flySuccess then
		addLog("飞行失败，重试...")
		sellState.consecutiveFailures += 1
		if sellState.consecutiveFailures >= 3 then
			addLog("连续出售失败3次，强制重置")
			resetSellState()
			return
		end
	end
	
	task.wait(0.3)
	
	local emptySuccess = false
	pcall(function()
		ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("EmptyBackpack"):FireServer()
		emptySuccess = true
	end)
	
	if not emptySuccess then
		addLog("清空背包失败")
	end
	
	task.wait(0.4)

	if autoUpgradeBagEnabled then
		pcall(function()
			buyBagUpgrade()
			task.wait(0.1)
		end)
	end

	if autoBuyToolsEnabled then
		pcall(function()
			buyTool("LeafBlower")
			task.wait(0.05)
			buyTool("Rake")
			task.wait(0.05)
		end)
	end

	Stats.leavesCollected += leaves
	Stats.sellCount += 1
	sellState.lastSellTime = tick()
	
	if emptySuccess then
		sellState.consecutiveFailures = 0
		addLog("出售完成: +" .. leaves .. " 树叶 (第" .. Stats.sellCount .. "次)")
	else
		addLog("出售过程中有错误，可能需要重试")
	end
	
	task.wait(0.2)
	sellState.isSelling = false
end

local function checkAttributeAndSell()
	if autoFarmEnabled and not infiniteBagMode and not sellState.isSelling then
		if isBagFull() then
			addLog("背包满检测，触发出售")
			task.spawn(sellLeavesProcess)
		end
	end
end

leafConnections[#leafConnections + 1] = LocalPlayer:GetAttributeChangedSignal("Leaves"):Connect(checkAttributeAndSell)
leafConnections[#leafConnections + 1] = LocalPlayer:GetAttributeChangedSignal("LeafCapacity"):Connect(checkAttributeAndSell)

-- ==================== 寻找最近树叶 ====================
local function findNearestLeaf()
	if not hrpCache then return nil, math.huge end
	local myPos = hrpCache.Position
	local nearestLeaf = nil
	local nearestDist = math.huge
	local toRemove = {}

	for leaf, _ in pairs(leafCache) do
		if isValidLeaf(leaf) then
			local dist = (leaf.Position - myPos).Magnitude
			if dist < nearestDist then
				nearestDist = dist
				nearestLeaf = leaf
			end
		else
			table.insert(toRemove, leaf)
		end
	end

	for _, leaf in ipairs(toRemove) do
		leafCache[leaf] = nil
	end

	if nearestLeaf == nil then
		scanAllLeaves()
	end

	return nearestLeaf, nearestDist
end

-- ==================== 范围收集 ====================
local function collectNearbyLeaves(radius)
	if not hrpCache or not LeafSim then return 0 end
	local myPos = hrpCache.Position
	local collected = 0
	local toRemove = {}

	for leaf, _ in pairs(leafCache) do
		if isValidLeaf(leaf) then
			if (leaf.Position - myPos).Magnitude <= radius then
				pcall(function()
					LeafSim.collect(leaf)
					table.insert(toRemove, leaf)
					collected += 1
					table.insert(collectHistory, 1, tick())
					
					if collected % 20 == 0 then
						task.wait()
					end
				end)
			end
		else
			table.insert(toRemove, leaf)
		end
	end

	for _, leaf in ipairs(toRemove) do
		leafCache[leaf] = nil
	end

	if collected > 0 then
		Stats.lastCollectTime = tick()
	end

	return collected
end

-- ==================== 主循环系统 ====================
local function startMainAutoLoop()
	if autoFarmEnabled then return end
	autoFarmEnabled = true
	isPaused = false
	Stats.startTime = tick()
	Stats.leavesCollected = 0
	Stats.sellCount = 0

	addLog("启动自动挂机...")
	resetSellState()
	checkAttributeAndSell()

	workerThread = task.spawn(function()
		while autoFarmEnabled do
			if isPaused then
				task.wait(0.5)
				continue
			end

			if checkAndFixSellHang() then
				task.wait(1)
				continue
			end

			if detectStuck() then
				recoveryFromStuck()
				continue
			end

			if sellState.isSelling then
				addLog("出售中... (已用时" .. math.floor(tick() - sellState.sellStartTime) .. "秒)")
				task.wait(0.3)
				continue
			end

			if isBagFull() then
				addLog("背包满 (达95%)，准备出售")
				sellLeavesProcess()
				task.wait(0.5)
				if not isBagFull() then
					addLog("出售成功，恢复收集")
				else
					addLog("出售可能未完成，等待重试")
					task.wait(1)
				end
				continue
			end

			if useFlyToLeaf then
				local nearestLeaf, dist = findNearestLeaf()
				if nearestLeaf then
					flyTo(nearestLeaf.Position + Vector3.new(0, 3, 0))
					
					if not sellState.isSelling then
						local collected = collectNearbyLeaves(collectionRadius)
						if collected > 0 then
							Stats.lastCollectTime = tick()
						elseif useSmartCollection then
							smartFlyPattern()
						end
					end
					task.wait(0.05)
				else
					scanAllLeaves()
					if useSmartCollection then
						smartFlyPattern()
					end
					task.wait(0.3)
				end
			else
				local processed = 0
				local toRemove = {}

				for leaf, _ in pairs(leafCache) do
					if not autoFarmEnabled or sellState.isSelling or isPaused then break end
					if isValidLeaf(leaf) then
						pcall(function()
							LeafSim.collect(leaf)
							table.insert(collectHistory, 1, tick())
						end)
						table.insert(toRemove, leaf)
						processed += 1
						
						if processed >= 30 then
							processed = 0
							task.wait()
						end
					else
						table.insert(toRemove, leaf)
					end
				end

				for _, leaf in ipairs(toRemove) do
					leafCache[leaf] = nil
				end

				if processed == 0 then
					scanAllLeaves()
				end

				task.wait(0.05)
			end
		end
	end)
end

local function stopMainAutoLoop()
	autoFarmEnabled = false
	isPaused = false

	if currentTween then
		currentTween:Cancel()
		currentTween = nil
	end

	if workerThread then
		task.cancel(workerThread)
		workerThread = nil
	end
	
	resetSellState()
	addLog("已停止自动挂机")
end

