-- ==================== 防卡机制 ====================
local function detectStuck()
	if #collectHistory > 10 then
		local recentCollects = 0
		for i = 1, math.min(10, #collectHistory) do
			if tick() - collectHistory[i] < 2 then
				recentCollects += 1
			end
		end
		
		if recentCollects == 0 then
			addLog("检测到卡顿，正在恢复...")
			return true
		end
	end
	return false
end

-- ==================== 状态恢复函数 ====================
local function resetSellState()
	sellState.isSelling = false
	sellState.sellStartTime = 0
	sellState.consecutiveFailures = 0
	addLog("出售状态已重置")
end

-- ==================== 检查并修复卖后卡顿 ====================
local function checkAndFixSellHang()
	if sellState.isSelling then
		local sellDuration = tick() - sellState.sellStartTime
		if sellDuration > sellState.sellTimeout then
			addLog("出售超时！强制重置状态...")
			resetSellState()
			return true
		end
	end
	return false
end

local function recoveryFromStuck()
	if currentTween then
		currentTween:Cancel()
		currentTween = nil
	end
	
	resetSellState()
	
	task.wait(0.5)
	scanAllLeaves()
	addLog("卡顿恢复完成")
	Stats.failureCount += 1
end

-- ==================== 叶子缓存系统 ====================
local function isValidLeaf(leaf)
	return leaf and leaf:IsA("BasePart") and leaf.Parent ~= nil and leaf.CanQuery and leaf.Transparency < 0.9
end

local function addLeafToCache(leaf)
	if isValidLeaf(leaf) then
		leafCache[leaf] = tick()
	end
end

local function removeLeafFromCache(leaf)
	leafCache[leaf] = nil
end

local function scanAllLeaves()
	local leafFolder = Workspace:FindFirstChild("Leaves")
	if not leafFolder then return end
	
	local found = 0
	for _, leaf in ipairs(leafFolder:GetDescendants()) do
		if isValidLeaf(leaf) then
			leafCache[leaf] = tick()
			found += 1
		end
	end
	
	if found > 0 then
		addLog("扫描完成: 找到 " .. found .. " 片树叶")
	end
end

local function setupFolderListeners()
	for _, conn in ipairs(leafConnections) do
		conn:Disconnect()
	end
	table.clear(leafConnections)

	local leafFolder = Workspace:WaitForChild("Leaves", 10)
	if leafFolder then
		leafConnections[#leafConnections + 1] = leafFolder.ChildAdded:Connect(function(child)
			if child:IsA("BasePart") then
				addLeafToCache(child)
			else
				for _, leaf in ipairs(child:GetDescendants()) do
					addLeafToCache(leaf)
				end
			end
		end)
		
		leafConnections[#leafConnections + 1] = leafFolder.DescendantAdded:Connect(addLeafToCache)
		leafConnections[#leafConnections + 1] = leafFolder.ChildRemoved:Connect(removeLeafFromCache)
		leafConnections[#leafConnections + 1] = leafFolder.DescendantRemoving:Connect(removeLeafFromCache)
	end
end

