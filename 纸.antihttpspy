-- [[ ULTRA ANTI-HTTPSPY FRAMEWORK v4.0 ]] --
-- [ 针对多款 HTTP Spy、底层 Metatable 监听、控制台 Hook 的全方位反制 ] --

local Task = task or {wait = wait, spawn = coroutine.wrap}
local Service = setmetatable({}, {
    __index = function(_, k)
        return game:GetService(k)
    end
})

local HttpService = Service.HttpService
local Players = Service.Players
local CoreGui = Service.CoreGui

--------------------------------------------------------------------------------
-- 1. 深度环境校验与隐蔽防御 (Anti-Metatable Hooking)
--------------------------------------------------------------------------------
local RawGetgenv = getgenv or function() return _G end
local env = RawGetgenv()

-- 恢复被改动的全局 debug 库 (反制 mock/Fake debug)
if type(debug) == "table" and debug.getinfo then
    local info = debug.getinfo(1)
    if info and info.source and info.source:find("mock") then
        pcall(function()
            env.debug = nil
        end)
    end
end

-- 混淆/清理常见检测标识与劫持句柄
local function SanitizeEnvironment()
    local badGlobals = {"islclosure", "isexecutorclosure", "isfunctionhooked", "isourclosure"}
    for _, name in ipairs(badGlobals) do
        env[name] = nil
    end
end
SanitizeEnvironment()

--------------------------------------------------------------------------------
-- 2. HTTP 抓包污染与垃圾数据轰炸 (Payload Pollution & Spam)
--------------------------------------------------------------------------------
local FakeEndpoints = {
    "https://httpbin.org/post",
    "https://api.github.com/users/octocat",
    "https://raw.githubusercontent.com/malicious/spy/main/log.lua",
    "https://discord.com/api/webhooks/00000000000000000/fake_webhook_token",
    "https://eleutheri.com/api/v1/whitelist/check"
}

local FakeHeaders = {
    ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) RobloxApp/1.0",
    ["Authorization"] = "Bearer FAKE_TOKEN_EXPLOIT_SPY_BYPASS_99999",
    ["Content-Type"] = "application/json"
}

-- 产生巨量膨胀垃圾日志，撑爆 UI/Log 文本
local function GenerateGarbagePayload()
    local t = {}
    for i = 1, 300 do
        t["FakeKey_" .. i] = string.rep("ANTI_SPY_NOISE_FLOOD_", 20)
    end
    return HttpService:JSONEncode(t)
end

-- 后台异步发射干扰请求，污染 Spy 的记录框与剪贴板
Task.spawn(function()
    while true do
        Task.wait(0.5)
        local targetUrl = FakeEndpoints[math.random(1, #FakeEndpoints)]
        local requestFunc = env.request or env.httprequest or (syn and syn.request)
        
        if requestFunc then
            pcall(function()
                requestFunc({
                    Url = targetUrl,
                    Method = "POST",
                    Headers = FakeHeaders,
                    Body = GenerateGarbagePayload()
                })
            end)
        end
    end
end)

--------------------------------------------------------------------------------
-- 3. 拦截 Hook 尝试并死锁控制台 (Anti-Hookfunction & Hookmetamethod)
--------------------------------------------------------------------------------
if env.hookfunction then
    local oldHook
    oldHook = env.hookfunction(env.hookfunction, env.newcclosure(function(target, hook)
        -- 阻止对 HttpGet / HttpPost / request 的 Hook 修改
        if target == game.HttpGet or target == game.HttpPost or target == env.request then
            warn("[DEFENSE] Denied attempt to hook HTTP core functions!")
            return function(...) return ... end
        end
        return oldHook(target, hook)
    end))
end

-- 反制针对 HttpService 的 __namecall 元方法劫持
if env.hookmetamethod then
    local rawNamecall
    rawNamecall = env.hookmetamethod(game, "__namecall", env.newcclosure(function(self, ...)
        local method = (env.getnamecallmethod and env.getnamecallmethod()) or ""
        if method == "HttpGet" or method == "HttpPost" or method == "HttpGetAsync" or method == "HttpPostAsync" then
            -- 返回虚假内容，防止实际被捕获真实参数
            return "{\"status\": \"blocked_by_anti_spy\"}"
        end
        return rawNamecall(self, ...)
    end))
end

--------------------------------------------------------------------------------
-- 4. 自动清除与销毁 UI Spy 界面 (Anti-GUI Scraper)
--------------------------------------------------------------------------------
local function PurgeSpyGUIs()
    local targetNames = {"HttpSpy", "HttpSpyGui", "NotificationFrame", "MainContainer"}
    
    local function ScanAndDestroy(parent)
        for _, child in ipairs(parent:GetChildren()) do
            for _, badName in ipairs(targetNames) do
                if child.Name == badName or child.Name:find("HttpSpy") then
                    pcall(function()
                        child:Destroy()
                    end)
                end
            end
        end
    end

    ScanAndDestroy(CoreGui)
    if Players.LocalPlayer then
        local playerGui = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if playerGui then
            ScanAndDestroy(playerGui)
        end
    end
end

-- 开启监听，一旦挂载 HttpSpy GUI 立即销毁
CoreGui.ChildAdded:Connect(function(child)
    if child.Name:find("Http") or child.Name:find("Spy") then
        Task.wait(0.05)
        pcall(function() child:Destroy() end)
    end
end)

Task.spawn(function()
    while true do
        PurgeSpyGUIs()
        Task.wait(1)
    end
end)

--------------------------------------------------------------------------------
-- 5. 抓包日志与剪贴板污染 (Anti-Clipboard & Anti-File Dump)
--------------------------------------------------------------------------------
if env.setclipboard or env.toclipboard then
    local setClip = env.setclipboard or env.toclipboard
    env.setclipboard = function(data)
        if type(data) == "string" and (data:find("HTTP") or data:find("Headers") or data:find("http_spy")) then
            -- 如果检测到尝试复制 HTTP 日志，替换为擦除提示
            setClip("[PROTECTED] Log content has been wiped by Anti-HTTPspy Framework.")
            return
        end
        setClip(data)
    end
    env.toclipboard = env.setclipboard
end

if env.writefile then
    local rawWrite = env.writefile
    env.writefile = function(filepath, content)
        if filepath:find("HttpSpy") or filepath:find("log.txt") then
            rawWrite(filepath, "-- Wiped by Anti-Spy Defender --")
            return
        end
        rawWrite(filepath, content)
    end
end

print("==========================================")
print("[+] Ultra Anti-HTTPspy Framework Initialized.")
print("[+] Protected against GUI Spies, Console Spies, & Metatable Hooks.")
print("==========================================")