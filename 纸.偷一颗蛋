local function inInventory(uid)
        if not uid then return false end
        local key=tostring(uid)
        local c=LP.Character
        if c then
                for _,t in ipairs(c:GetChildren()) do
                        if t:IsA("Tool") then
                                local u=t:GetAttribute("UID") or t:GetAttribute("Uid") or t:GetAttribute("EggUid")
                                if u and tostring(u)==key then return true end
                        end
                end
        end
        local b=LP:FindFirstChild("Backpack")
        if b then
                for _,t in ipairs(b:GetChildren()) do
                        if t:IsA("Tool") then
                                local u=t:GetAttribute("UID") or t:GetAttribute("Uid") or t:GetAttribute("EggUid")
                                if u and tostring(u)==key then return true end
                        end
                end
        end
        return false
end

local function getHeldUid()
        local c=LP.Character
        if c then
                for _,t in ipairs(c:GetChildren()) do
                        if t:IsA("Tool") then
                                local u=t:GetAttribute("UID") or t:GetAttribute("Uid") or t:GetAttribute("EggUid")
                                if u then return u end
                        end
                end
        end
        local b=LP:FindFirstChild("Backpack")
        if b then
                local found=nil
                local count=0
                for _,t in ipairs(b:GetChildren()) do
                        if t:IsA("Tool") then
                                local u=t:GetAttribute("UID") or t:GetAttribute("Uid") or t:GetAttribute("EggUid")
                                if u then
                                        count=count+1
                                        found=u
                                        if count>1 then return nil end
                                end
                        end
                end
                if count==1 then return found end
        end
        return nil
end

local function findDropped(uid)
        if not uid then return nil end
        local key=tostring(uid)
        local ok,snap=pcall(function() return EggState.ReadFieldEggs() end)
        if ok and snap and snap.Records then
                for _,rec in ipairs(snap.Records) do
                        if tostring(rec.Uid)==key and rec.BottomCFrame then
                                if rec.State=="Dropped" or rec.State=="Slot" then return rec end
                        end
                end
        end
        return nil
end

local function recoverUid(uid)
        if AntiDrop.recovering or not uid then return end
        AntiDrop.recovering=true
        local dropped=findDropped(uid)
        if not dropped or not dropped.BottomCFrame then
                AntiDrop.recovering=false
                return
        end
        local pos=dropped.BottomCFrame.Position
        local r=hrp()
        if r then
                pcall(function() LP:RequestStreamAroundAsync(pos) end)
                r.CFrame=CFrame.new(pos.X,pos.Y+2,pos.Z)
                r.AssemblyLinearVelocity=Vector3.zero
                r.AssemblyAngularVelocity=Vector3.zero
        end
        local deadline=os.clock()+0.4
        local lastRemote=0
        while AntiDrop.enabled and os.clock()<=deadline do
                if inInventory(uid) then break end
                local now=os.clock()
                if now-lastRemote>=0.12 then
                        lastRemote=now
                        pcall(function() EggState.CarryFieldEgg(uid,nil) end)
                end
                RunService.Heartbeat:Wait()
        end
        if inInventory(uid) then
                AntiDrop.lockedUid=uid
                AntiDrop.lastOwned=os.clock()
        end
        AntiDrop.recovering=false
end

task.spawn(function()
        while true do
                task.wait(0.2)
                if not AntiDrop.enabled then continue end
                local now=os.clock()
                local held=getHeldUid()
                if held then
                        AntiDrop.lockedUid=held
                        AntiDrop.lastOwned=now
                end
                local uid=AntiDrop.lockedUid
                if uid and not AntiDrop.recovering then
                        if inInventory(uid) then
                                AntiDrop.lastOwned=now
                        else
                                local d=findDropped(uid)
                                if d then
                                        task.spawn(function() recoverUid(uid) end)
                                elseif now-AntiDrop.lastOwned>2 then
                                        AntiDrop.lockedUid=nil
                                end
                        end
                end
        end
end)

