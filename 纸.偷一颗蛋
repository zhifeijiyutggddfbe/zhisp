local function cnName(raw)
        if not raw or raw=="" then return "未知" end
        return petCN[raw] or raw
end
local function cnRarity(raw)
        if not raw or raw=="" then return "未知" end
        return rarityCN[raw] or raw
end

local function pickIcon(entry)
        if not entry then return nil end
        local keys={"Icon","ImageId","Thumbnail","AssetId","IconId","Image","Portrait","ImageID","IconImage"}
        for _,k in ipairs(keys) do
                local v=entry[k]
                if type(v)=="string" and v~="" then
                        if v:find("rbxassetid://") or v:find("rbxasset://") then return v end
                        if v:match("^%d+$") then return "rbxassetid://"..v end
                end
        end
        if entry.Rarity then
                for _,k in ipairs(keys) do
                        local v=entry.Rarity[k]
                        if type(v)=="string" and v~="" then
                                if v:find("rbxassetid://") or v:find("rbxasset://") then return v end
                                if v:match("^%d+$") then return "rbxassetid://"..v end
                        end
                end
        end
        return nil
end

