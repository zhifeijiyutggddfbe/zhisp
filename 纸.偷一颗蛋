local function clearESP()
        for uid,marker in pairs(espCache) do
                if marker.Part and marker.Part.Parent then marker.Part:Destroy() end
                espCache[uid]=nil
        end
end

local function updateESP()
        if not State.eggESP then
                if next(espCache) then clearESP() end
                return
        end
        local ok,result=pcall(function() return EggState.ReadFieldEggs() end)
        if not ok or type(result)~="table" then return end
        local records=result.Records or result
        if type(records)~="table" then return end
        local seen={}
        for _,record in ipairs(records) do
                local uid=record.Uid
                if uid then
                        seen[uid]=true
                        local marker=espCache[uid]
                        if not marker or not marker.Part or not marker.Part.Parent then
                                marker=makeMarker()
                                espCache[uid]=marker
                        end
                        local position=record.BottomCFrame and record.BottomCFrame.Position
                        if position then marker.Part.CFrame=CFrame.new(position) end
                        local entry=Assets.Directory and Assets.Directory[record.AssetCategory]
                        local rawName=entry and (entry.DisplayName or entry.Name) or record.AssetCategory or "未知"
                        local petName=cnName(rawName)
                        local rarityName="未知"
                        local rarityColor=Color3.fromRGB(200,210,220)
                        if entry and entry.Rarity then
                                rarityName=cnRarity(entry.Rarity.DisplayName or entry.Rarity.Name)
                                if entry.Rarity.Color then rarityColor=entry.Rarity.Color end
                        end
                        marker.NameLabel.Text=petName
                        if State.eggESPInfo then
                                local value
                                if entry then
                                        for _,k in ipairs({"Value","Price","Cost","SellPrice","Worth","Gold","Coins"}) do
                                                if entry[k]~=nil then value=entry[k] break end
                                        end
                                        if value==nil and entry.Rarity and entry.Rarity.Value~=nil then value=entry.Rarity.Value end
                                end
                                local valueText=value~=nil and tostring(value) or "?"
                                marker.InfoLabel.Text=string.format("%s · 价值 %s",rarityName,valueText)
                                marker.InfoLabel.TextColor3=rarityColor
                                marker.InfoLabel.Visible=true
                        else marker.InfoLabel.Visible=false end
                        if State.eggESPState then
                                marker.StateLabel.Text=string.format("状态: %s",tostring(record.State or "?"))
                                marker.StateLabel.Visible=true
                        else marker.StateLabel.Visible=false end
                        if State.eggESPIcon then
                                local icon=pickIcon(entry)
                                marker.IconFrame.Visible=true
                                marker.IconImage.Image=icon or ""
                        else marker.IconFrame.Visible=false end
                        marker.Stroke.Color=rarityColor
                end
        end
        for uid,marker in pairs(espCache) do
                if not seen[uid] then
                        if marker.Part then marker.Part:Destroy() end
                        espCache[uid]=nil
                end
        end
end

