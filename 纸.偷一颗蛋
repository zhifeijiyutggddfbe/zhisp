        local maxTime=1.2
        local scan=getgc or (debug and debug.getgc)
        if type(scan)~="function" then return end
        local ok,objs=pcall(scan,true)
        if not ok or type(objs)~="table" then return end
        local setmeta=setrawmetatable or setmetatable
        local getmeta=getrawmetatable or getmetatable
        local getconstants=getconstants or (debug and debug.getconstants)
        local setconstant=setconstant or (debug and debug.setconstant)
        local batch=200
        for i=1,#objs do
                local obj=objs[i]
                objs[i]=nil
                if obj~=nil then
                        if setmeta and type(obj)=="table" then
                                local hasMeta=getmeta and getmeta(obj)
                                if not hasMeta then
                                        local selfRef=false
                                        for _,v in pairs(obj) do
                                                if v==obj then selfRef=true break end
                                        end
                                        if selfRef then
                                                for _,v in pairs(obj) do
                                                        if type(v)=="number" and v>=1 and v<=3 and obj[v]==nil then
                                                                pcall(setmeta,obj,{__newindex=function() end})
                                                                break
                                                        end
                                                end
                                        end
                                end
                        end
                        if getconstants and setconstant and type(obj)=="function" and debug and debug.info then
                                local okS,src=pcall(debug.info,obj,"s")
                                if okS and type(src)=="string"
                                        and src:find("ReplicatedFirst",1,true)
                                        and src:find("UGI",1,true) then
                                        local okC,consts=pcall(getconstants,obj)
                                        if okC and type(consts)=="table" then
                                                for idx,c in next,consts do
                                                        if type(c)=="string" and c=="Humanoid" then
                                                                pcall(setconstant,obj,idx,"")
                                                        end
                                                end
                                        end
                                end
                        end
                end
                if i%batch==0 then
                        task.wait()
                        if os.clock()-started>maxTime then break end
                end
        end
end)

