local function fn9(target)
        local hrp=fn7()
        if not hrp then return end
        local character=hrp.Parent
        if not character then return end
        for _,child in ipairs(character:GetChildren()) do
                if child:IsA("BasePart") then child.CanCollide=false end
        end
        local humanoid=character:FindFirstChildOfClass("Humanoid")
        local speed=State.tweenSpeed
        if State.useOwnSpeed then
                local ws=humanoid and humanoid.WalkSpeed or 16
                speed=math.max(ws*4,60)
        end
        local flightY=State.flightY

        local function flyStep(goal)
                local startTime=os.clock()
                local lastTime=os.clock()
                while hrp.Parent and os.clock()-startTime<6 do
                        local current=hrp.Position
                        local diff=goal-current
                        local dist=diff.Magnitude
                        if dist<=1.5 then
                                hrp.CFrame=CFrame.new(goal)
                                hrp.AssemblyLinearVelocity=Vector3.zero
                                hrp.AssemblyAngularVelocity=Vector3.zero
                                return true
                        end
                        local now=os.clock()
                        local dt=math.min(now-lastTime,0.08)
                        lastTime=now
                        local step=math.min(speed*dt,dist)
                        local newPos=current+diff.Unit*step
                        hrp.CFrame=CFrame.new(newPos)
                        hrp.AssemblyLinearVelocity=Vector3.zero
                        hrp.AssemblyAngularVelocity=Vector3.zero
                        RunService.Heartbeat:Wait()
                end
                return false
        end

        local startPos=hrp.Position
        local targetY=math.max(target.Y+15,flightY)
        flyStep(Vector3.new(startPos.X,targetY,startPos.Z))
        flyStep(Vector3.new(target.X,targetY,target.Z))
        flyStep(Vector3.new(target.X,target.Y,target.Z))
        task.wait(0.15)
end

