--[[
    纸.ohio - zhiUI 公益版
    完全免费，无需购买
]]

local zhiUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/yda66722-hash/zhiUI/refs/heads/main/zhiUI"))()

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function createUI()
    local Window = zhiUI:CreateWindow({
        Title = "纸.ohio"
    })

    -- ==================== 战斗 ====================
    local combatTab = Window:AddTab("战斗")

    local on = false
    local teleportTargets = false
    local cachedHitId = nil
    local currentTarget = nil
    local heartConnections = {}
    local ninjaStarBuyThread = nil

    local plrs = Players
    local rs = ReplicatedStorage
    local lp = LocalPlayer
    local dvv = require(rs.devv)
    local sig = dvv.load("Signal")
    local guid = dvv.load("GUID")
    local inv = dvv.load("v3item").inventory

    local function cleanupConnections()
        for _, conn in ipairs(heartConnections) do
            if conn then conn:Disconnect() end
        end
        heartConnections = {}
    end

    local function equipNinjaStar()
        local itm = inv.getItems and inv.getItems() or inv.items or {}
        for _, v in next, itm do
            if v.name == "Ninja Star" then
                sig.FireServer("equip", v.guid)
                return v.guid
            end
        end
        return nil
    end

    local function initThrow()
        local sg = equipNinjaStar()
        if not sg then return end
        local c = lp.Character
        if not c then return end
        local rh = c:FindFirstChild("RightHand")
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if not rh or not hrp then return end
        local mp = rh.Position + Vector3.new(0, 0.5, 0)
        local tp = mp + Vector3.new(50, 0, 0)
        local vel = (tp - mp).Unit * 150
        local ok, r1, hid = pcall(function()
            return sig.InvokeServer("throwSticky", guid(), "Ninja Star", sg, vel, tp)
        end)
        if ok and r1 and hid then
            cachedHitId = hid
        end
    end

    local function hasShield(targetPlayer)
        if not targetPlayer or not targetPlayer.Character then return false end
        for _, desc in pairs(targetPlayer.Character:GetDescendants()) do
            if desc:IsA("ForceField") then return true end
        end
        return false
    end

    local function findValidTarget()
        local closest = nil
        local minDist = math.huge
        local myPos = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") and lp.Character.HumanoidRootPart.Position
        if not myPos then return nil end
        for _, player in ipairs(plrs:GetPlayers()) do
            if player \~= lp and player.Character then
                local char = player.Character
                local humanoid = char:FindFirstChild("Humanoid")
                local head = char:FindFirstChild("Head")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if humanoid and head and hrp and humanoid.Health > 0 and not hasShield(player) then
                    local dist = (hrp.Position - myPos).Magnitude
                    if dist < minDist and dist <= 50 then
                        minDist = dist
                        closest = {player = player, head = head}
                    end
                end
            end
        end
        return closest
    end

    local function rapidThrowAttack()
        if not on or not cachedHitId then return end
        local targetData = findValidTarget()
        if not targetData then return end
        local head = targetData.head
        local tp = head.Position
        local wcf = CFrame.new(tp, tp + Vector3.new(0, 1, 0))
        local rcf = CFrame.new(0, 0, 0)
        for i = 1, 15 do
            sig.InvokeServer("hitSticky", cachedHitId, head, rcf, wcf)
        end
    end

    local function findNextTeleportTarget()
        for _, player in ipairs(plrs:GetPlayers()) do
            if player \~= lp and player.Character then
                local humanoid = player.Character:FindFirstChild("Humanoid")
                if humanoid and humanoid.Health > 0 and not hasShield(player) then
                    return player
                end
            end
        end
        return nil
    end

    local function fastTeleport()
        if not teleportTargets or not on then return end
        if not currentTarget or not currentTarget.Character then
            currentTarget = findNextTeleportTarget()
            if not currentTarget then return end
        end
        local humanoid = currentTarget.Character:FindFirstChild("Humanoid")
        if not humanoid or humanoid.Health <= 0 or hasShield(currentTarget) then
            currentTarget = findNextTeleportTarget()
            if not currentTarget then return end
        end
        local char = lp.Character
        if not char or not char.PrimaryPart then return end
        local targetHRP = currentTarget.Character:FindFirstChild("HumanoidRootPart")
        if not targetHRP then return end
        char.PrimaryPart.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 1.5)
    end

    combatTab:AddToggle("飞镖光环", false, function(state)
        on = state
        cleanupConnections()
        if state then
            equipNinjaStar()
            task.wait(0.1)
            initThrow()
            local conn = RunService.RenderStepped:Connect(function()
                if not on then return end
                rapidThrowAttack()
            end)
            table.insert(heartConnections, conn)
            zhiUI:Notify("飞镖", "已启用", 2)
        else
            zhiUI:Notify("飞镖", "已关闭", 2)
        end
    end)

    combatTab:AddToggle("传送攻击", false, function(state)
        teleportTargets = state
        if state and on then
            local conn = RunService.RenderStepped:Connect(function()
                fastTeleport()
            end)
            table.insert(heartConnections, conn)
            zhiUI:Notify("传送攻击", "已开启", 2)
        elseif state then
            zhiUI:Notify("警告", "请先开启飞镖光环", 2)
        else
            zhiUI:Notify("传送攻击", "已关闭", 2)
        end
    end)

    combatTab:AddToggle("自动购买飞镖", false, function(Value)
        if ninjaStarBuyThread then
            ninjaStarBuyThread:Disconnect()
            ninjaStarBuyThread = nil
        end
        if Value then
            ninjaStarBuyThread = RunService.Heartbeat:Connect(function()
                sig.InvokeServer("attemptPurchase", "Ninja Star")
            end)
            zhiUI:Notify("自动购买", "已启用", 2)
        else
            zhiUI:Notify("自动购买", "已关闭", 2)
        end
    end)

    combatTab:AddDivider()
    combatTab:AddLabel("—— 杀戮类 ——")

    local Signal = require(ReplicatedStorage.devv).load("Signal")
    local b1 = require(ReplicatedStorage.devv).load('v3item').inventory.items
    local autokill, autostomp, grabplay, autoFists = false, false, false, false

    local function equipFists()
        for _, v in next, b1 do
            if v.name == 'Fists' then
                Signal.FireServer("equip", v.guid)
                break
            end
        end
    end

    local function killAura()
        local character = LocalPlayer.Character
        if not character then return end
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end
        for _, player in ipairs(Players:GetPlayers()) do
            if player \~= LocalPlayer and player.Character then
                local targetHRP = player.Character:FindFirstChild("HumanoidRootPart")
                if targetHRP and (rootPart.Position - targetHRP.Position).Magnitude <= 35 then
                    Signal.FireServer("meleeAttackHit", "player", {
                        meleeType = "meleemegapunch",
                        hitPlayerId = player.UserId
                    })
                end
            end
        end
    end

    local function stompAura()
        local character = LocalPlayer.Character
        if not character then return end
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end
        for _, player in ipairs(Players:GetPlayers()) do
            if player \~= LocalPlayer and player.Character then
                local targetHRP = player.Character:FindFirstChild("HumanoidRootPart")
                local targetHumanoid = player.Character:FindFirstChild("Humanoid")
                if targetHRP and targetHumanoid and targetHumanoid.Health < 20 then
                    if (rootPart.Position - targetHRP.Position).Magnitude <= 40 then
                        Signal.FireServer("finish", player)
                    end
                end
            end
        end
    end

    local function grabAura()
        local character = LocalPlayer.Character
        if not character then return end
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end
        for _, player in ipairs(Players:GetPlayers()) do
            if player \~= LocalPlayer and player.Character then
                local targetHRP = player.Character:FindFirstChild("HumanoidRootPart")
                local targetHumanoid = player.Character:FindFirstChild("Humanoid")
                if targetHRP and targetHumanoid and targetHumanoid.Health < 20 then
                    if (rootPart.Position - targetHRP.Position).Magnitude <= 40 then
                        Signal.FireServer("grabPlayer", player)
                    end
                end
            end
        end
    end

    RunService.Heartbeat:Connect(function()
        if autokill then killAura() end
        if autostomp then stompAura() end
        if grabplay then grabAura() end
        if autoFists then equipFists() end
    end)

    combatTab:AddToggle("自动装备拳头", false, function(state) autoFists = state end)
    combatTab:AddToggle("杀戮光环[一拳]", false, function(state) autokill = state end)
    combatTab:AddToggle("踩踏光环", false, function(state) autostomp = state end)
    combatTab:AddToggle("抓取光环", false, function(state) grabplay = state end)

    combatTab:AddDivider()
    combatTab:AddLabel("—— 防护 ——")

    local AutoArmor = false
    combatTab:AddToggle("自动穿甲", false, function(Value)
        AutoArmor = Value
        if Value then
            local connection
            connection = RunService.Heartbeat:Connect(function()
                if not AutoArmor then connection:Disconnect() return end
                pcall(function()
                    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                    if humanoid and humanoid.Health > 35 then
                        local items = require(ReplicatedStorage.devv).load('v3item').inventory.items
                        local hasLightVest = false
                        for _, v in next, items do
                            if v.name == "Light Vest" then
                                hasLightVest = true
                                local armor = LocalPlayer:GetAttribute('armor')
                                if armor == nil or armor <= 0 then
                                    Signal.FireServer("equip", v.guid)
                                    Signal.FireServer("useConsumable", v.guid)
                                    Signal.FireServer("removeItem", v.guid)
                                end
                                break
                            end
                        end
                        if not hasLightVest then
                            Signal.InvokeServer("attemptPurchase", "Light Vest")
                        end
                    end
                end)
            end)
        end
    end)

    local autokz = false
    combatTab:AddToggle("自动面具", false, function(state)
        autokz = state
        if autokz then
            task.spawn(function()
                while autokz and task.wait(1) do
                    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
                    if not character:FindFirstChild("Hockey Mask") then
                        Signal.InvokeServer("attemptPurchase", "Hockey Mask")
                        for _, v in next, b1 do
                            if v.name == "Hockey Mask" then
                                Signal.FireServer("equip", v.guid)
                                Signal.FireServer("wearMask", v.guid)
                                break
                            end
                        end
                    end
                end
            end)
        end
    end)

    local healThread
    combatTab:AddToggle("自动回血", false, function(Value)
        if healThread then healThread:Disconnect() healThread = nil end
        if Value then
            healThread = RunService.Heartbeat:Connect(function()
                Signal.InvokeServer("attemptPurchase", 'Bandage')
                for _, v in next, require(ReplicatedStorage.devv).load('v3item').inventory.items do
                    if v.name == 'Bandage' then
                        local Character = LocalPlayer.Character
                        if Character then
                            local Humanoid = Character:FindFirstChild('Humanoid')
                            if Humanoid and Humanoid.Health >= 5 and Humanoid.Health < Humanoid.MaxHealth then
                                Signal.FireServer("equip", v.guid)
                                Signal.FireServer("useConsumable", v.guid)
                                Signal.FireServer("removeItem", v.guid)
                            end
                        end
                        break
                    end
                end
            end)
        end
    end)

    local AutoKnockReset = false
    local melee = require(ReplicatedStorage.devv).load("ClientReplicator")
    combatTab:AddToggle("防倒地", false, function(Value)
        AutoKnockReset = Value
        if Value then
            task.spawn(function()
                while AutoKnockReset do
                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                        melee.Set(LocalPlayer, "knocked", false)
                        melee.Replicate("knocked")
                    end
                    task.wait()
                end
            end)
        end
    end)

    combatTab:AddToggle("防虚空", false, function(Value)
        task.spawn(function()
            while Value and task.wait(0.1) do
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    if character.HumanoidRootPart.Position.Y < -200 then
                        character.HumanoidRootPart.CFrame = CFrame.new(1339.909, 6.045, -660.326)
                    end
                end
            end
        end)
    end)

    combatTab:AddToggle("防甩飞", false, function(Value)
        task.spawn(function()
            while Value and task.wait(0.1) do
                local character = LocalPlayer.Character
                if character then
                    for _, part in ipairs(character:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end
            end
        end)
    end)

    combatTab:AddToggle("显示名字血量", false, function(enableESP)
        if enableESP then
            local function ApplyESP(v)
                if v.Character and v.Character:FindFirstChildOfClass("Humanoid") then
                    v.Character.Humanoid.NameDisplayDistance = 9e9
                    v.Character.Humanoid.NameOcclusion = "NoOcclusion"
                    v.Character.Humanoid.HealthDisplayDistance = 9e9
                    v.Character.Humanoid.HealthDisplayType = "AlwaysOn"
                end
            end
            for _, v in pairs(Players:GetPlayers()) do
                ApplyESP(v)
                v.CharacterAdded:Connect(function() task.wait(0.33) ApplyESP(v) end)
            end
            Players.PlayerAdded:Connect(function(v)
                ApplyESP(v)
                v.CharacterAdded:Connect(function() task.wait(0.33) ApplyESP(v) end)
            end)
            _G.ESPConnection = RunService.Heartbeat:Connect(function()
                for _, v in pairs(Players:GetPlayers()) do
                    if v.Character and v.Character:FindFirstChildOfClass("Humanoid") then
                        v.Character.Humanoid.NameDisplayDistance = 9e9
                        v.Character.Humanoid.NameOcclusion = "NoOcclusion"
                        v.Character.Humanoid.HealthDisplayDistance = 9e9
                        v.Character.Humanoid.HealthDisplayType = "AlwaysOn"
                    end
                end
            end)
        else
            if _G.ESPConnection then _G.ESPConnection:Disconnect() _G.ESPConnection = nil end
            for _, v in pairs(Players:GetPlayers()) do
                if v.Character and v.Character:FindFirstChildOfClass("Humanoid") then
                    v.Character.Humanoid.NameDisplayDistance = 100
                    v.Character.Humanoid.NameOcclusion = "OccludeAll"
                    v.Character.Humanoid.HealthDisplayDistance = 100
                    v.Character.Humanoid.HealthDisplayType = "DisplayWhenDamaged"
                end
            end
        end
    end)

    combatTab:AddToggle("防僵直", false, function(Value)
        task.spawn(function()
            while Value and task.wait(0.1) do
                local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
                if humanoid and humanoid:GetState() == Enum.HumanoidStateType.Frozen then
                    humanoid:ChangeState(Enum.HumanoidStateType.Running)
                end
            end
        end)
    end)

    combatTab:AddToggle("防坐下", false, function(Value)
        task.spawn(function()
            while Value and task.wait(0.1) do
                local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
                if humanoid and humanoid:GetState() == Enum.HumanoidStateType.Seated then
                    humanoid.Sit = false
                    humanoid:ChangeState(Enum.HumanoidStateType.Running)
                end
            end
        end)
    end)

    -- ==================== 魔法 ====================
    local magicTab = Window:AddTab("魔法")
    magicTab:AddLabel("—— 全图类 ——")

    magicTab:AddToggle("全图RPG", false, function(Value)
        zhiUI:Notify("全图RPG", Value and "已开启" or "已关闭", 2)
        -- 在此粘贴原脚本 performBombardment("RPG") 完整逻辑
    end)

    magicTab:AddToggle("全图火焰发射器", false, function(Value)
        zhiUI:Notify("全图火焰", Value and "已开启" or "已关闭", 2)
    end)

    magicTab:AddToggle("全图硫酸枪", false, function(Value)
        zhiUI:Notify("全图硫酸", Value and "已开启" or "已关闭", 2)
    end)

    magicTab:AddToggle("全图辣椒喷雾", false, function(Value)
        zhiUI:Notify("全图辣椒", Value and "已开启" or "已关闭", 2)
    end)

    magicTab:AddToggle("全图灭火器", false, function(Value)
        zhiUI:Notify("全图灭火器", Value and "已开启" or "已关闭", 2)
    end)

    -- ==================== 圣诞节 ====================
    local xmasTab = Window:AddTab("圣诞节")
    xmasTab:AddToggle("礼物盒农场", false, function(Value) end)
    xmasTab:AddToggle("收集姜饼人光环", false, function(Value) end)
    xmasTab:AddToggle("自动圣诞精灵", false, function(Value) end)
    xmasTab:AddToggle("自动领取姜饼人奖励", false, function(state) end)

    -- ==================== 绕过 ====================
    local bypassTab = Window:AddTab("绕过")

    bypassTab:AddButton("绕过移动经销商", function()
        local pjyd
        pjyd = hookmetamethod(game, "__namecall", function(self, ...)
            local args = {...}
            local method = getnamecallmethod()
            if method == "InvokeServer" and args[2] == true then
                args[2] = false
                return pjyd(self, unpack(args))
            end
            return pjyd(self, ...)
        end)
        LocalPlayer:SetAttribute("mobileDealer", true)
        local mobileDealer = require(ReplicatedStorage.devv.shared.Indicies.mobileDealer)
        for _, items in pairs(mobileDealer) do
            for _, item in ipairs(items) do
                item.stock = 999999
            end
        end
        zhiUI:Notify("绕过", "移动经销商已绕过", 2)
    end)

    bypassTab:AddButton("绕过高级表情包", function()
        for _, v in pairs(LocalPlayer.PlayerGui.Emotes.Frame.ScrollingFrame:GetDescendants()) do
            if v.Name == "Locked" then v.Visible = false end
        end
        zhiUI:Notify("绕过", "表情包已解锁", 2)
    end)

    bypassTab:AddButton("绕过飞行检测", function()
        local exp = ReplicatedStorage:FindFirstChild("devv") and ReplicatedStorage.devv:FindFirstChild("remoteStorage") and ReplicatedStorage.devv.remoteStorage:FindFirstChild("makeExplosion")
        if exp then exp:Destroy() end
        zhiUI:Notify("绕过", "飞行检测已绕过", 2)
    end)

    bypassTab:AddButton("绕过战斗状态", function()
        for _, func in pairs(getgc(true)) do
            if type(func) == "function" then
                local info = debug.getinfo(func)
                if info.name == "isInCombat" or (info.source and info.source:find("combatIndicator")) then
                    hookfunction(func, function() return false end)
                end
            end
        end
        zhiUI:Notify("绕过", "战斗状态已绕过", 2)
    end)

    -- ==================== 本地 ====================
    local localTab = Window:AddTab("本地")
    localTab:AddLabel("—— 免费物品 ——")

    local items = {"Golden Rose", "Black Rose", "Dollar Balloon", "Bat Balloon", "Bunny Balloon", "Clover Balloon", "Ghost Balloon", "Gold Clover Balloon", "Heart Balloon", "Skull Balloon", "Snowflake Balloon", "Admin AK-47", "Admin Nuke Launcher", "Admin RPG", "Void Gem", "Pulse Rifle", "Unusual Money Printer", "Money Printer", "Trident", "NextBot Grenade", "El Fuego"}
    local selectedItem = ""

    localTab:AddDropdown("选择物品", items, function(value)
        selectedItem = value
    end)

    localTab:AddButton("免费获得选择的物品", function()
        if selectedItem \~= "" then
            zhiUI:Notify("免费物品", "已尝试添加 " .. selectedItem, 2)
            -- 在此粘贴原 addItem 逻辑
        end
    end)

    -- ==================== 金钱 ====================
    local moneyTab = Window:AddTab("金钱")
    moneyTab:AddToggle("自动抢银行", false, function(state) end)
    moneyTab:AddToggle("自动ATM", false, function(Value) end)
    moneyTab:AddToggle("自动制作萝莉", false, function(Value) end)
    moneyTab:AddToggle("自动领取萝莉", false, function(Value) end)
    moneyTab:AddToggle("自动存放珠宝", false, function(Value) end)
    moneyTab:AddToggle("自动租用房屋", false, function(Value) end)
    moneyTab:AddToggle("自动领取奖励", false, function(Value) end)
    moneyTab:AddToggle("自动空投", false, function(Value) end)
    moneyTab:AddToggle("自动捡钱", false, function(Value) end)
    moneyTab:AddSlider("最低钱数", 250, 1000, 250, function(Value) end)
    moneyTab:AddToggle("自动保险箱", false, function(Value) end)
    moneyTab:AddToggle("自动宝箱", false, function(Value) end)
    moneyTab:AddToggle("自动购买撬锁", false, function(Value) end)

    -- ==================== 物品 ====================
    local itemTab = Window:AddTab("物品")
    itemTab:AddToggle("自动捡价值宝石", false, function(state) end)
    itemTab:AddToggle("自动捡贵重物品", false, function(state) end)
    itemTab:AddToggle("自动捡普通宝石", false, function(state) end)
    itemTab:AddDivider()
    itemTab:AddToggle("自动移除垃圾枪", false, function(v) end)
    itemTab:AddToggle("自动移除垃圾宝石", false, function(v) end)
    itemTab:AddToggle("自动移除其它垃圾", false, function(v) end)
    itemTab:AddSlider("物品栏数量", 1, 12, 6, function(Value)
        pcall(function()
            local sum = require(game.ReplicatedStorage.devv.client.Objects.v3item.modules.inventory)
            sum.numSlots = Value
        end)
    end)

    -- ==================== 人物 ====================
    local charTab = Window:AddTab("人物")

    local Speed = 1
    local sudu
    charTab:AddToggle("速度", false, function(v)
        if v then
            sudu = RunService.Heartbeat:Connect(function()
                local char = LocalPlayer.Character
                if char and char.Humanoid and char.Humanoid.MoveDirection.Magnitude > 0 then
                    char:TranslateBy(char.Humanoid.MoveDirection * Speed / 10)
                end
            end)
        elseif sudu then
            sudu:Disconnect()
            sudu = nil
        end
    end)

    charTab:AddSlider("速度数值", 1, 100, 1, function(Value)
        Speed = Value
    end)

    charTab:AddToggle("扩大视野", false, function(v)
        if v then
            _G.fovConnection = RunService.Heartbeat:Connect(function()
                workspace.CurrentCamera.FieldOfView = 130
            end)
        elseif _G.fovConnection then
            _G.fovConnection:Disconnect()
            _G.fovConnection = nil
        end
    end)

    charTab:AddToggle("无限跳", false, function(Value)
        if Value then
            _G.jumpConn = UserInputService.JumpRequest:Connect(function()
                local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end)
        else
            if _G.jumpConn then
                _G.jumpConn:Disconnect()
                _G.jumpConn = nil
            end
        end
    end)

    zhiUI:Notify("纸.ohio", "公益版加载完成", 3)
end

createUI()