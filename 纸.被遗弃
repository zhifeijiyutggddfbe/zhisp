-- ==========================================================
-- 工具函数
-- ==========================================================

local function getCharacter()
    return LocalPlayer.Character
end

local function getHumanoid()
    local char = getCharacter()
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
    local char = getCharacter()
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getRemoteFolder()
    return ReplicatedStorage:FindFirstChild("Systems")
end

-- ==========================================================
-- 无限体力
-- ==========================================================

local function updateStamina()
    pcall(function()
        local sprinting = require(
            ReplicatedStorage.Systems.Character.Game.Sprinting
        )

        if State.infiniteStamina then
            sprinting.StaminaLossDisabled = true
        else
            sprinting.StaminaLossDisabled = false
        end

        if State.killerStamina then
            sprinting.MinStamina = -100000
        else
            sprinting.MinStamina = 0
        end
    end)
end

