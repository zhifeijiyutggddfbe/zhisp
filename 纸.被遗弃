                end
            end
            h:ChangeState(Enum.HumanoidStateType.Swimming)
            swimHB = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local c = LocalPlayer.Character
                    local hrp = c and c:FindFirstChild("HumanoidRootPart")
                    if hrp and h then
                        if h.MoveDirection == Vector3.new() and not UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                            hrp.Velocity = Vector3.new()
                        end
                    end
                end)
            end)
        else
            stopSwim()
        end
    end)

    LocalPlayer.CharacterAdded:Connect(function()
        if swimEnabled then swimEnabled = false; stopSwim() end
    end)
end

