-- ==========================================================
-- 自动修发电机
-- ==========================================================

local function getMap()
    local map = workspace:FindFirstChild("Map")
    if not map then
        return nil
    end

    local ingame = map:FindFirstChild("Ingame")
    if not ingame then
        return nil
    end

    return ingame:FindFirstChild("Map")
end

local function getNearestGenerator()
    local map = getMap()
    local root = getRoot()

    if not map or not root then
        return nil
    end

    local nearest = nil
    local nearestDistance = math.huge

    for _, generator in ipairs(map:GetChildren()) do
        if generator.Name == "Generator" then

            local progress = generator:FindFirstChild("Progress")

            if progress and progress.Value < 100 then

                local main =
                    generator:FindFirstChild("Main")
                    or generator.PrimaryPart
                    or generator:FindFirstChildWhichIsA(
                        "BasePart",
                        true
                    )

                if main then
                    local distance =
                        (main.Position - root.Position).Magnitude

                    if distance < nearestDistance then
                        nearestDistance = distance
                        nearest = generator
                    end
                end
            end
        end
    end

    return nearest
end

local function repairGenerator()
    pcall(function()

        local generator = getNearestGenerator()

        if not generator then
            return
        end

        local remotes = generator:FindFirstChild("Remotes")

        if not remotes then
            return
        end

        local remote = remotes:FindFirstChild("RE")

        if remote and remote:IsA("RemoteEvent") then
            remote:FireServer()
        end

    end)
end

MainTab:AddToggle(
    "自动修发电机",
