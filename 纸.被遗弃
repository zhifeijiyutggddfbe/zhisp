do
    local u2 = { killAllActive = false, killAllFly = false, killAllTeleport = false, flying = false }
    local u4 = { flySpeed = 50 }
    local u5 = { currentTarget = nil }
    local u6 = { killConn = nil, flightConn = nil, bodyGyro = nil, bodyVel = nil }

    local function stopFly()
        if u2.flying then
            u2.flying = false
            if u6.flightConn then u6.flightConn:Disconnect(); u6.flightConn = nil end
            if u6.bodyGyro then u6.bodyGyro:Destroy(); u6.bodyGyro = nil end
            if u6.bodyVel then u6.bodyVel:Destroy(); u6.bodyVel = nil end
            local c = LocalPlayer.Character
            if c then
                local h = c:FindFirstChildOfClass("Humanoid")
                if h then h.AutoRotate = true end
            end
        end
    end

    local function startFly()
        if u2.flying then return end
        u2.flying = true
        local c = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp = c:WaitForChild("HumanoidRootPart")
        local h = c:FindFirstChildOfClass("Humanoid")
        if h then
            h.AutoRotate = false
            u6.bodyGyro = Instance.new("BodyGyro")
            u6.bodyGyro.P = 90000
            u6.bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            u6.bodyGyro.CFrame = hrp.CFrame
            u6.bodyGyro.Parent = hrp
            u6.bodyVel = Instance.new("BodyVelocity")
            u6.bodyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            u6.bodyVel.Velocity = Vector3.zero
            u6.bodyVel.Parent = hrp
            u6.flightConn = RunService.Heartbeat:Connect(function()
                local cam = Workspace.CurrentCamera
                local lv = cam.CFrame.LookVector
                local rv = cam.CFrame.RightVector
                local md = h.MoveDirection
                local f = md:Dot(Vector3.new(lv.X, 0, lv.Z).Unit)
                local r = md:Dot(Vector3.new(rv.X, 0, rv.Z).Unit)
                local up = md.Magnitude <= 0 and 0 or lv.Y * f
                local v = lv * f + rv * r
                local fv = Vector3.new(v.X, up, v.Z)
                if fv.Magnitude > 1 then fv = fv.Unit end
                u6.bodyVel.Velocity = fv * u4.flySpeed
                u6.bodyGyro.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + lv, cam.CFrame.UpVector)
            end)
        end
    end

    local function getNearestSurv()
        local c = LocalPlayer.Character
        if not c then return nil end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        local sv = getSurvivorsFolder()
        if not sv then return nil end
        local best, bd = nil, math.huge
        for _, m in ipairs(sv:GetChildren()) do
            if m:IsA("Model") and m:FindFirstChild("Humanoid") and m.Humanoid.Health > 0 then
                local r = m:FindFirstChild("HumanoidRootPart")
                if r then
                    local d = (r.Position - hrp.Position).Magnitude
                    if d < bd then best = m; bd = d end
                end
            end
        end
        return best
    end

    local function moveTo(t)
        if not t or not t:FindFirstChild("HumanoidRootPart") then return end
        local c = LocalPlayer.Character
        local hrp = c and c:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local tr = t.HumanoidRootPart
        if u2.killAllTeleport then
            local lv = tr.CFrame.LookVector
            local p = tr.Position - lv * 2.7 + Vector3.new(0, 1.5, 0)
            hrp.CFrame = CFrame.new(p)
            hrp.CFrame = CFrame.lookAt(p, tr.Position)
        elseif u2.killAllFly then
            if not u2.flying then startFly() end
            local u = (tr.Position - hrp.Position).Unit
            c.Humanoid:MoveTo(hrp.Position + u * 10)
        else
            c.Humanoid:MoveTo(tr.Position)
        end
    end

    local function startKillAll()
        if not u2.killAllActive then
            u2.killAllActive = true
            u6.killConn = RunService.Heartbeat:Connect(function()
                if u2.killAllActive then
                    if u5.currentTarget and (not u5.currentTarget.Parent
                        or not u5.currentTarget:FindFirstChild("Humanoid")
                        or u5.currentTarget.Humanoid.Health <= 0)
                    then u5.currentTarget = nil end
                    if not u5.currentTarget then
                        u5.currentTarget = getNearestSurv()
                        if not u5.currentTarget then return end
                    end
                    moveTo(u5.currentTarget)
                end
            end)
        end
    end

    local function stopKillAll()
        if u2.killAllActive then
            u2.killAllActive = false
            if u6.killConn then pcall(function() u6.killConn:Disconnect() end); u6.killConn = nil end
            u5.currentTarget = nil
            local c = LocalPlayer.Character
            if c and c:FindFirstChildOfClass("Humanoid") then
                pcall(function() c.Humanoid:MoveTo(c.HumanoidRootPart.Position) end)
            end
            if u2.flying then stopFly() end
        end
    end

    KillerTab:AddToggle("击杀模式", false, function(v)
        if v then startKillAll() else stopKillAll() end
        zhiUI:Notify("击杀模式", v and "已开启" or "已关闭", 2)
    end)

    KillerTab:AddToggle("传送模式", false, function(v)
        u2.killAllTeleport = v
        if v then u2.killAllFly = false end
        zhiUI:Notify("传送模式", v and "已开启" or "已关闭", 2)
    end)

    KillerTab:AddButton("切换目标", function()
        u5.currentTarget = getNearestSurv()
        zhiUI:Notify("目标", "已切换", 2)
    end)

    LocalPlayer.CharacterAdded:Connect(function()
        if u2.killAllActive then stopKillAll() end
    end)
    LocalPlayer.CharacterRemoving:Connect(function()
        if u2.flying then stopFly() end
    end)
end

