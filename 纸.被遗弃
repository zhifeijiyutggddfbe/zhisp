local function isPlayerBehindKiller(hrp, khrp, dist)
    if dist > proximity or dist < 0.01 then return false end
    local toPlayer = (hrp.Position - khrp.Position).Unit
    local back = -khrp.CFrame.LookVector
    return toPlayer:Dot(back) >= math.cos(math.rad(BEHIND_CONE_DEGREES))
end

local function removeDebugLine()
    if debugBeam then pcall(function() debugBeam:Destroy() end); debugBeam = nil end
end

local function drawDebugLine(hrp, khrp, valid)
    if not DEBUG_LINE then removeDebugLine() return end
    pcall(function()
        local a0 = hrp:FindFirstChild("__BSAtt0") or Instance.new("Attachment", hrp)
        a0.Name = "__BSAtt0"; a0.Position = Vector3.zero
        local a1 = khrp:FindFirstChild("__BSAtt1") or Instance.new("Attachment", khrp)
        a1.Name = "__BSAtt1"; a1.Position = Vector3.zero
        if not debugBeam then
            local b = Instance.new("Beam")
            b.Name = "__BSBeam"
            b.Attachment0 = a0; b.Attachment1 = a1
            b.FaceCamera = true; b.Width0 = 0.08; b.Width1 = 0.08
            b.Segments = 1; b.LightEmission = 1; b.LightInfluence = 0
            b.Parent = hrp; debugBeam = b
        end
        debugBeam.Attachment0 = a0; debugBeam.Attachment1 = a1
        debugBeam.Color = valid and ColorSequence.new(Color3.fromRGB(50,220,100))
            or ColorSequence.new(Color3.fromRGB(220,80,60))
    end)
end

local function activateForKiller(killer, duration)
    if not killer then return end
    local c = LocalPlayer.Character
    local h = c and c:FindFirstChildWhichIsA("Humanoid")
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    local khrp = killer:FindFirstChild("HumanoidRootPart")
    if not h or not hrp or not khrp then return end
    aimRefCount = aimRefCount + 1
    if aimRefCount == 1 then pcall(function() h.AutoRotate = false end) end
    local function finishAiming()
        aimRefCount = math.max(0, aimRefCount - 1)
        if aimRefCount == 0 then setAutoRotate(true) end
    end
    local function behindCF()
        local kcf = khrp.CFrame
        local bp = kcf.Position - (kcf.LookVector.Unit * BEHIND_DISTANCE)
        bp = Vector3.new(bp.X, kcf.Position.Y, bp.Z)
        return CFrame.new(bp, bp + kcf.LookVector.Unit)
    end
    if backstabType == "Lerp" then
        local t0 = os.clock()
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if os.clock() - t0 >= duration then conn:Disconnect(); finishAiming(); return end
            if khrp and hrp and hrp.Parent then
                hrp.CFrame = hrp.CFrame:Lerp(behindCF(), LERP_SPEED)
            end
        end)
    elseif backstabType == "Teleport" then
        pcall(function() hrp.CFrame = behindCF() end)
        task.delay(duration, finishAiming)
    elseif backstabType == "Aim" then
        local t0 = os.clock()
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if os.clock() - t0 >= duration then conn:Disconnect(); finishAiming(); return end
            if khrp and hrp and hrp.Parent then
                local st = khrp.Position + khrp.CFrame.LookVector * 2
                local ap = Vector3.new(st.X, hrp.Position.Y, st.Z)
                hrp.CFrame = hrp.CFrame:Lerp(CFrame.new(hrp.Position, ap), LERP_SPEED * 1.8)
            end
        end)
    end
end

task.spawn(function()
    while true do
        task.wait(CHECK_INTERVAL)
        if not bsEnabled then continue end
        local kf = getKillersFolder()
        if not kf then continue end
