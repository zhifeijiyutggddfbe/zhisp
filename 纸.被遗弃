        Lighting.FogStart = _env.NoFog and 0 or (Lighting:GetAttribute("FogStart") or 0)
        Lighting.FogEnd = _env.NoFog and math.huge or (Lighting:GetAttribute("FogEnd") or math.huge)
        local atm = Lighting:FindFirstChildOfClass("Atmosphere")
        if atm then
            if not atm:GetAttribute("Density") then atm:SetAttribute("Density", atm.Density) end
            atm.Density = _env.NoFog and 0 or atm:GetAttribute("Density")
        end
        if _env.Fullbright then
            Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
            Lighting.Brightness = _env.Brightness or 0
            Lighting.GlobalShadows = not _env.GlobalShadows
        else
            Lighting.OutdoorAmbient = Color3.fromRGB(55, 55, 55)
            Lighting.Brightness = 0
            Lighting.GlobalShadows = true
        end
    end

    local function toggleLoop(on)
        if on then
            RunService.RenderStepped:Connect(updateLighting)
