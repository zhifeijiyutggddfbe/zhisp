do
    local Camera = Workspace.CurrentCamera
    local dashTurn = { sixer = false, coolkid = false, noli = false, noliActive = false, noliOrigWS = nil, noliConn = nil }

    local function getCamDir()
        local cf = Camera.CFrame
        local f = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
        local r = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
        local x, z = 0, 0
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then z = z - 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then z = z + 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then x = x - 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then x = x + 1 end
        local dir = f * -z + r * x
        if dir.Magnitude > 0.01 then return dir.Unit end
        if f.Magnitude > 0.01 then return f.Unit end
        return Vector3.new(0, 0, -1)
    end

    RunService:BindToRenderStep("SixerAirStrafe", Enum.RenderPriority.Character.Value + 2, function()
        if not dashTurn.sixer then return end
        local c = LocalPlayer.Character
        if not c then return end
        if c:GetAttribute("PursuitState") ~= "Dashing" then return end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        local h = c:FindFirstChildOfClass("Humanoid")
        if not hrp or not h then return end
        if h.FloorMaterial ~= Enum.Material.Air then return end
        local flat = Camera.CFrame.LookVector * Vector3.new(1, 0, 1)
        if flat.Magnitude < 0.01 then return end
        flat = flat.Unit
        local v = hrp.AssemblyLinearVelocity
        local hv = Vector3.new(v.X, 0, v.Z)
        if hv.Magnitude < 0.1 then return end
        local nh = hv:Lerp(flat * hv.Magnitude, 1)
        hrp.AssemblyLinearVelocity = Vector3.new(nh.X, v.Y, nh.Z)
    end)

    RunService.RenderStepped:Connect(function(dt)
        if dashTurn.coolkid then
            local c = LocalPlayer.Character
            local hrp = c and c:FindFirstChild("HumanoidRootPart")
            if c and hrp and c:GetAttribute("FootstepsMuted") == true then
                local dir = getCamDir()
                local lv = hrp:FindFirstChildWhichIsA("LinearVelocity")
                if lv then lv.LineDirection = dir end
                if dir.Magnitude > 0.01 then
                    local tr = CFrame.new(hrp.Position, hrp.Position + dir).Rotation
                    hrp.CFrame = CFrame.new(hrp.Position) * hrp.CFrame.Rotation:Lerp(tr, math.min(dt * 16, 1))
                end
            end
