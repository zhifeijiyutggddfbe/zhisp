                local r = m:FindFirstChild("HumanoidRootPart")
                if h and r and h.Health > 0 then
                    local d = (r.Position - hrp.Position).Magnitude
                    if d < bd and d <= suction.maxDist then bd = d; best = r end
                end
            end
        end
        suction.cache.target = best
        return best
    end

    local function push(tr)
        if not tr or not tr.Parent then return end
        local c = LocalPlayer.Character
        local hrp = c and c:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local d = tr.Position - hrp.Position
        if d.Magnitude < 0.1 then return end
