local originalPrivacy = {}
local function savePrivacy(p)
    if originalPrivacy[p.UserId] then return end
    originalPrivacy[p.UserId] = {}
    pcall(function()
        local pr = p.PlayerData and p.PlayerData.Settings and p.PlayerData.Settings.Privacy
        if not pr then return end
        for _, k in ipairs({"HideKillerWins","HidePlaytime","HideSurvivorWins"}) do
            local v = pr:FindFirstChild(k)
            if v then originalPrivacy[p.UserId][k] = v.Value end
        end
    end)
end
local function revealPrivacy(p)
    pcall(function()
        local pr = p.PlayerData and p.PlayerData.Settings and p.PlayerData.Settings.Privacy
        if not pr then return end
        for _, k in ipairs({"HideKillerWins","HidePlaytime","HideSurvivorWins"}) do
            local v = pr:FindFirstChild(k)
            if v then v.Value = false end
        end
    end)
end
local function restorePrivacy(p)
    pcall(function()
        local saved = originalPrivacy[p.UserId]
        if not saved then return end
        local pr = p.PlayerData and p.PlayerData.Settings and p.PlayerData.Settings.Privacy
        if not pr then return end
        for k, val in pairs(saved) do
            local v = pr:FindFirstChild(k)
            if v then v.Value = val end
        end
    end)
end

