local itemColors = {
    BloxyCola = Color3.fromRGB(255, 140, 0),
    Medkit = Color3.fromRGB(255, 100, 255),
}

local function createItemESP(part)
    if not part or not part:IsA("BasePart") then return end
    if part.Name ~= "ItemRoot" or not part.Parent then return end
    local tag = part.Parent.Name
    local color = itemColors[tag] or Color3.fromRGB(255, 255, 255)

    if not part:FindFirstChild(tag .. "_PESP") then
        local box = Instance.new("BoxHandleAdornment")
        box.Name = tag .. "_PESP"
        box.Adornee = part
        box.Size = part.Size
        box.Transparency = 0.5
        box.Color3 = color
        box.ZIndex = 0
        box.AlwaysOnTop = true
        box.Parent = part
    end
    if not part:FindFirstChild("ESP_Billboard") then
        local bb = Instance.new("BillboardGui")
        bb.Name = "ESP_Billboard"
        bb.Size = UDim2.new(0, 100, 0, 30)
        bb.Adornee = part
        bb.AlwaysOnTop = true
        bb.StudsOffset = Vector3.new(0, 2.5, 0)
        bb.Parent = part
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3 = color
        lbl.TextStrokeTransparency = 0
        lbl.Text = tag
        lbl.Font = Enum.Font.SourceSansBold
        lbl.TextSize = 10
        lbl.Parent = bb
    end
end

local function enableItemESP()
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and v.Name == "ItemRoot" then createItemESP(v) end
    end
    if not itemESPConn then
        itemESPConn = Workspace.DescendantAdded:Connect(function(part)
            if part:IsA("BasePart") and part.Name == "ItemRoot" then createItemESP(part) end
        end)
    end
end

local function disableItemESP()
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and v.Name == "ItemRoot" then
            local bb = v:FindFirstChild("ESP_Billboard")
            if bb then bb:Destroy() end
            local tag = v.Parent and v.Parent.Name
            if tag then
                local box = v:FindFirstChild(tag .. "_PESP")
                if box then box:Destroy() end
            end
        end
    end
    if itemESPConn then itemESPConn:Disconnect(); itemESPConn = nil end
end

