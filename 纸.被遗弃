do
    local aim = { on = false, cooldown = 0.3, lockTime = 0.4, maxDist = 30, smooth = 0.35,
        targeting = false, target = nil, deathConn = nil, autoRotate = nil, lastFired = 0, hum = nil, hrp = nil, cache = {}, cacheTime = 0, cacheLife = 0.5 }

    local function isKiller()
        local c = LocalPlayer.Character
        if not c then return false end
        local kf = getKillersFolder()
        return kf and c:IsDescendantOf(kf)
    end

    local function refreshChar(ch)
        aim.hum = ch and ch:FindFirstChildOfClass("Humanoid")
        aim.hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    end

    local function refreshTargets()
        local now = tick()
        if now - aim.cacheTime < aim.cacheLife then return end
        aim.cacheTime = now
        aim.cache = {}
        local sv = getSurvivorsFolder()
        if not sv then return end
        for _, m in ipairs(sv:GetChildren()) do
            if m ~= LocalPlayer.Character and m:IsA("Model") then
                local h = m:FindFirstChildOfClass("Humanoid")
                local r = m:FindFirstChild("HumanoidRootPart")
                if h and r and h.Health > 0 then table.insert(aim.cache, r) end
            end
        end
    end

    local function nearest()
        refreshTargets()
        if not aim.hrp or #aim.cache == 0 then return nil end
        local best, bd = nil, math.huge
        for _, r in ipairs(aim.cache) do
            local d = (r.Position - aim.hrp.Position).Magnitude
            if d < bd and d <= aim.maxDist then bd = d; best = r end
        end
        return best
    end

    function aimUnlock()
        if not aim.targeting then return end
        if aim.deathConn then aim.deathConn:Disconnect(); aim.deathConn = nil end
        if aim.autoRotate ~= nil and aim.hum then aim.hum.AutoRotate = aim.autoRotate end
        aim.targeting = false; aim.target = nil
    end

    local function lock(rp)
        if not rp or not rp.Parent or not aim.hum or not aim.hrp then return end
        if aim.targeting and aim.target == rp then return end
        aimUnlock()
        aim.target = rp; aim.targeting = true
        aim.autoRotate = aim.hum.AutoRotate
        aim.hum.AutoRotate = false
        local th = rp.Parent:FindFirstChildOfClass("Humanoid")
        if th then aim.deathConn = th.Died:Connect(aimUnlock) end
        task.delay(aim.lockTime, function()
            if aim.target == rp then aimUnlock() end
        end)
    end

    local remote = ReplicatedStorage:FindFirstChild("Modules")
        and ReplicatedStorage.Modules:FindFirstChild("Network")
        and ReplicatedStorage.Modules.Network:FindFirstChild("Network")
        and ReplicatedStorage.Modules.Network.Network:FindFirstChild("RemoteEvent")
    if remote then
        remote.OnClientEvent:Connect(function(...)
            if not aim.on then return end
            local args = {...}
            if type(args[1]) ~= "string" then return end
            local n = args[1]
            if n:match("Ability") or n:match("[QER]")
                or n == "Slash" or n == "Dagger" or n == "Charge"
                or n == "Stab" or n == "Punch"
            then
                if tick() - aim.lastFired < aim.cooldown then return end
                aim.lastFired = tick()
                if isKiller() then
                    local t = nearest()
                    if t then lock(t) end
                end
            end
        end)
    end

    LocalPlayer.CharacterAdded:Connect(function(ch)
        task.wait(0.5); refreshChar(ch)
    end)
    if LocalPlayer.Character then refreshChar(LocalPlayer.Character) end

    RunService.RenderStepped:Connect(function()
        if not aim.on or not aim.targeting or not aim.hrp or not aim.target then return end
        if not aim.target.Parent then aimUnlock(); return end
        local th = aim.target.Parent:FindFirstChildOfClass("Humanoid")
        if not th or th.Health <= 0 then aimUnlock(); return end
        local flat = Vector3.new(aim.target.Position.X - aim.hrp.Position.X, 0, aim.target.Position.Z - aim.hrp.Position.Z).Unit
        if flat.Magnitude > 0 then
            aim.hrp.CFrame = aim.hrp.CFrame:Lerp(CFrame.new(aim.hrp.Position, aim.hrp.Position + flat), aim.smooth)
        end
    end)

    KillerTab:AddToggle("使用自瞄", false, function(s)
        aim.on = s
        if not s then aimUnlock() end
        zhiUI:Notify("自瞄", s and "已开启" or "已关闭", 2)
    end)

    KillerTab:AddSlider("冷却时间 (秒)", 0.1, 2.0, aim.cooldown, function(v) aim.cooldown = v end)
    KillerTab:AddSlider("锁定时间 (秒)", 0.1, 3.0, aim.lockTime, function(v) aim.lockTime = v end)
    KillerTab:AddSlider("最大距离", 5, 100, aim.maxDist, function(v) aim.maxDist = v end)
    KillerTab:AddSlider("旋转平滑度", 0.05, 1.0, aim.smooth, function(v) aim.smooth = v end)
end

