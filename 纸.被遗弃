do
    local abs = { on = false, range = 40, duration = 1.5, locked = false, soundConn = nil, scanThread = nil, rings = {} }
    local absSounds = { ["86710781315432"] = true, ["99820161736138"] = true }

    local function addRing(model)
        pcall(function()
            local hrp = model:FindFirstChild("HumanoidRootPart")
            if not hrp or abs.rings[model] then return end
            local ring = Instance.new("Part")
            ring.Name = "AbsRing"
            ring.Shape = Enum.PartType.Cylinder
            ring.Size = Vector3.new(0.1, abs.range * 2, abs.range * 2)
            ring.Color = Color3.fromRGB(220, 50, 50)
            ring.Material = Enum.Material.ForceField
            ring.Transparency = 0.5
            ring.CanCollide = false
            ring.CanTouch = false
            ring.CFrame = hrp.CFrame * CFrame.Angles(0, 0, math.rad(90))
            ring.Parent = hrp
            local w = Instance.new("WeldConstraint")
            w.Part0 = hrp; w.Part1 = ring; w.Parent = ring
            abs.rings[model] = ring
        end)
    end

    local function removeRing(model)
        pcall(function()
            local r = abs.rings[model]
            if r then r:Destroy() end
            abs.rings[model] = nil
        end)
    end

    local function findTwoTime()
        local pf = Workspace:FindFirstChild("Players")
        if not pf then return nil end
        for _, f in ipairs(pf:GetChildren()) do
            local tt = f:FindFirstChild("TwoTime")
            if tt then return tt end
        end
        return nil
    end

    local function trigger()
        pcall(function()
            if abs.locked then return end
            local c = LocalPlayer.Character
            local mr = c and c:FindFirstChild("HumanoidRootPart")
            if not mr then return end
            local tt = findTwoTime()
            if not tt then return end
            local tr = tt:FindFirstChild("HumanoidRootPart")
            if not tr then return end
            if (mr.Position - tr.Position).Magnitude > abs.range then return end
            abs.locked = true
            task.spawn(function()
                local dl = tick() + abs.duration
                while tick() < dl do
                    if not abs.on then break end
                    local c2 = LocalPlayer.Character
                    local r2 = c2 and c2:FindFirstChild("HumanoidRootPart")
                    if not r2 or not tr.Parent then break end
                    r2.CFrame = CFrame.lookAt(r2.Position, Vector3.new(tr.Position.X, r2.Position.Y, tr.Position.Z))
                    RunService.RenderStepped:Wait()
                end
                abs.locked = false
            end)
        end)
    end

    local function hookSounds()
        pcall(function()
            if abs.soundConn then abs.soundConn:Disconnect(); abs.soundConn = nil end
            local function check(o)
                if not abs.on or not o:IsA("Sound") then return end
                local id = o.SoundId:match("%d+")
                if id and absSounds[id] then trigger() end
            end
            abs.soundConn = Workspace.DescendantAdded:Connect(function(o)
                if o:IsA("Sound") then
                    check(o)
                    o:GetPropertyChangedSignal("SoundId"):Connect(function() check(o) end)
                end
            end)
        end)
    end

    local function startScan()
        if abs.scanThread then return end
        abs.scanThread = task.spawn(function()
            while abs.on do
                pcall(function()
                    local pf = Workspace:FindFirstChild("Players")
                    if pf then
                        for _, f in ipairs(pf:GetChildren()) do
                            for _, m in ipairs(f:GetChildren()) do
                                if m.Name == "TwoTime" then addRing(m) end
                            end
                        end
                    end
                    for m in pairs(abs.rings) do
                        if not m.Parent then removeRing(m) end
                    end
                end)
                task.wait(1)
            end
            abs.scanThread = nil
        end)
    end

    local function start()
        pcall(function() hookSounds(); startScan() end)
    end

    local function stop()
        pcall(function()
            abs.on = false
            if abs.soundConn then abs.soundConn:Disconnect(); abs.soundConn = nil end
            if abs.scanThread then task.cancel(abs.scanThread); abs.scanThread = nil end
            for m in pairs(abs.rings) do removeRing(m) end
            abs.locked = false
        end)
    end

    LocalPlayer.CharacterAdded:Connect(function()
        pcall(function()
            abs.locked = false
            if abs.on then start() end
        end)
    end)

    KillerTab:AddToggle("启用防背刺", false, function(s)
        pcall(function()
            abs.on = s
            if s then start() else stop() end
        end)
        zhiUI:Notify("防背刺", s and "已开启" or "已关闭", 2)
    end)

    KillerTab:AddSlider("检测范围", 10, 120, abs.range, function(v)
        pcall(function()
            abs.range = v
            for _, r in pairs(abs.rings) do
                if r and r.Parent then r.Size = Vector3.new(0.1, v * 2, v * 2) end
            end
        end)
    end)

    KillerTab:AddSlider("注视时间", 0.3, 5.0, abs.duration, function(v)
        pcall(function() abs.duration = v end)
    end)
end

