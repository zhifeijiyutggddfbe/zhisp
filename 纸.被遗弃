local function removeModelESP(model)
    if not model then return end
    local d = modelESP[model]
    if d then
        pcall(function() if d.billboard then d.billboard:Destroy() end end)
        pcall(function() if d.highlight then d.highlight:Destroy() end end)
        modelESP[model] = nil
    end
    pcall(function()
        local bb = model:FindFirstChild("ESP_NameBillboard")
        if bb then bb:Destroy() end
        local hl = model:FindFirstChild("ESP_Highlight")
        if hl then hl:Destroy() end
    end)
end

local function attachModelESP(model, color)
    if not model or not model:IsA("Model") then return end
    if modelESP[model] then return end
    if not model:FindFirstChildOfClass("Humanoid") then return end
    local head = model:FindFirstChild("Head") or model:FindFirstChildWhichIsA("BasePart", true)
    if not head then return end

    local bb = Instance.new("BillboardGui")
    bb.Name = "ESP_NameBillboard"
    bb.Adornee = head
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.Size = UDim2.new(0, 200, 0, 50)
    bb.Enabled = false
    bb.Parent = model

    local lbl = Instance.new("TextLabel")
    lbl.Name = "NameLabel"
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = color
    lbl.TextStrokeTransparency = 0
    lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
    lbl.TextSize = 10
    lbl.Font = Enum.Font.GothamBold
    lbl.Text = "..."
    lbl.Parent = bb

    local hl = Instance.new("Highlight")
    hl.Name = "ESP_Highlight"
    hl.Adornee = model
    hl.FillTransparency = 1
    hl.OutlineTransparency = 0
    hl.OutlineColor = color
    hl.Enabled = false
    hl.Parent = model

    modelESP[model] = { billboard = bb, label = lbl, highlight = hl }

    model.AncestryChanged:Connect(function(_, parent)
        if not parent then removeModelESP(model) end
    end)
end

local function updateModelESPText(model)
    local d = modelESP[model]
    if not d or not d.label then return end
    local actor = model:GetAttribute("ActorDisplayName") or "???"
    local skin = model:GetAttribute("SkinNameDisplay")
    if actor == "Noli" and model:GetAttribute("IsFakeNoli") == true then
        actor = actor .. " (假)"
    end
    local text = actor
    if skin and tostring(skin) ~= "" then text = text .. " | " .. skin end
    local h = model:FindFirstChildOfClass("Humanoid")
    if h then
        text = string.format("%s (%d/%d)", text, math.floor(h.Health), math.floor(h.MaxHealth))
    end
    d.label.Text = text
end

local function scanFolderForESP(folder, color)
    if not folder then return end
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") then
            attachModelESP(m, color)
            updateModelESPText(m)
        end
    end
end

local function updateFakeNolis()
    pcall(function()
        local kf = getKillersFolder()
        if not kf then return end
        local byUser = {}
        for _, m in ipairs(kf:GetChildren()) do
            if m:GetAttribute("ActorDisplayName") == "Noli" then
                local u = m:GetAttribute("Username")
                if u then
                    byUser[u] = byUser[u] or {}
                    table.insert(byUser[u], m)
                end
            end
            m:SetAttribute("IsFakeNoli", false)
        end
        for _, list in pairs(byUser) do
            if #list > 1 then
                for i = 2, #list do list[i]:SetAttribute("IsFakeNoli", true) end
            end
        end
    end)
end

local function hookFolder(folder, color)
    if not folder then return end
    folder.ChildAdded:Connect(function(child)
        task.spawn(function()
            task.wait(0.3)
            if child and child.Parent == folder and child:IsA("Model") then
                attachModelESP(child, color)
                updateModelESPText(child)
            end
        end)
    end)
    folder.ChildRemoved:Connect(function(child) removeModelESP(child) end)
end

