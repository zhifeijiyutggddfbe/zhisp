        end

    end

end)

-- ==========================================================
-- ESP 核心
-- ==========================================================

local function removeESP(model)

    if not model then
        return
    end

    local data = ESPObjects[model]

    if data then

        if data.highlight then
            pcall(function()
                data.highlight:Destroy()
            end)
        end

        if data.billboard then
            pcall(function()
                data.billboard:Destroy()
            end)
        end

        ESPObjects[model] = nil

    else

        local highlight = model:FindFirstChild(
            "PaperAbandonedESP"
        )

        local billboard = model:FindFirstChild(
            "PaperAbandonedName"
        )

        if highlight then
            highlight:Destroy()
        end

        if billboard then
            billboard:Destroy()
        end

    end
end

local function clearESP()

    for model in pairs(ESPObjects) do
        removeESP(model)
    end

    table.clear(ESPObjects)

end

local function createESP(model, color, text)

    if not model or not model:IsA("Model") then
        return
    end

    if not model.Parent then
        return
    end

    local existing = ESPObjects[model]

    if existing then

        if existing.highlight then
            existing.highlight.FillColor = color
            existing.highlight.OutlineColor = color
        end

        if existing.label then
            existing.label.Text = text
            existing.label.TextColor3 = color
        end

        return
    end

    local adornee =
        model.PrimaryPart
        or model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    if not adornee then
        return
    end

    -- Highlight

    local highlight = Instance.new("Highlight")

    highlight.Name = "PaperAbandonedESP"
    highlight.Adornee = model
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.FillTransparency = 0.45
    highlight.OutlineTransparency = 0
    highlight.DepthMode =
        Enum.HighlightDepthMode.AlwaysOnTop

    highlight.Parent = model

    -- Billboard

    local billboard = Instance.new("BillboardGui")

    billboard.Name = "PaperAbandonedName"
    billboard.Adornee = adornee
    billboard.Size = UDim2.new(0, 140, 0, 35)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 10000

    local label = Instance.new("TextLabel")

    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = color
    label.TextStrokeColor3 = Color3.new(0, 0, 0)
    label.TextStrokeTransparency = 0
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13

    label.Parent = billboard
    billboard.Parent = model

    ESPObjects[model] = {
        highlight = highlight,
        billboard = billboard,
        label = label,
    }

end

-- ==========================================================
-- 杀手 ESP
-- ==========================================================

local function updateKillerESP()

    if not State.espKillers then
        return
    end

    local playersFolder =
        workspace:FindFirstChild("Players")

    local killers =
        playersFolder
        and playersFolder:FindFirstChild("Killers")

    if not killers then
        return
    end

    for _, model in ipairs(killers:GetChildren()) do

        if model:IsA("Model") then

            createESP(
                model,
                Color3.fromRGB(255, 50, 50),
                "杀手"
            )

        end
    end

end

-- ==========================================================
-- 幸存者 ESP
-- ==========================================================

local function updateSurvivorESP()

    if not State.espSurvivors then
        return
    end

    local playersFolder =
        workspace:FindFirstChild("Players")

    local survivors =
        playersFolder
        and playersFolder:FindFirstChild("Survivors")

    if not survivors then
        return
    end

    for _, model in ipairs(survivors:GetChildren()) do

        if model:IsA("Model")
            and model.Name ~= LocalPlayer.Name then

            createESP(
                model,
                Color3.fromRGB(50, 255, 100),
                model.Name
            )

        end
    end

end

-- ==========================================================
-- 发电机 ESP
-- ==========================================================

local function updateGeneratorESP()

    if not State.espGenerators then
        return
    end

    local map = getMap()

    if not map then
        return
    end

    for _, generator in ipairs(map:GetChildren()) do

        if generator.Name == "Generator" then

            local progress =
                generator:FindFirstChild("Progress")

            local value = 0

            if progress then
                value = progress.Value
            end

            if value >= 100 then

                createESP(
                    generator,
                    Color3.fromRGB(50, 255, 100),
                    "电机 100%"
                )

            else

                createESP(
                    generator,
                    Color3.fromRGB(255, 80, 80),
                    "电机 " .. math.floor(value) .. "%"
                )

            end
        end
    end

end

-- ==========================================================
-- ESP 总刷新
-- ==========================================================

task.spawn(function()

    while task.wait(0.5) do

        pcall(function()

            updateKillerESP()
            updateSurvivorESP()
            updateGeneratorESP()

            for model in pairs(ESPObjects) do

                if not model
                    or not model.Parent then

                    removeESP(model)

                end

            end

        end)

    end

end)

