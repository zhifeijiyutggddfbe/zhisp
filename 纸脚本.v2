-- 纸.脚本中心 v2
-- zhiUI 通用脚本中心
-- 单独执行版本
-- ==========================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local TextChatService = game:GetService("TextChatService")

local LocalPlayer = Players.LocalPlayer

-- ==========================================================
-- 加载 zhiUI
-- ==========================================================

local zhiUI = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/yda66722-hash/zhiUI/refs/heads/main/zhiUI"
))()

local Window = zhiUI:CreateWindow({
    Title = "纸.脚本中心v2"
})

local GeneralTab = Window:AddTab("通用")
local ExclusiveTab = Window:AddTab("专属游戏")
local ToolTab = Window:AddTab("工具与其他")

-- ==========================================================
-- 设置
-- ==========================================================

local settings = {
    flyEnabled = false,
    flySpeed = 50,

    noclip = false,

    speedHack = false,
    walkSpeed = 100,

    skyJump = false,

    spinBot = false,

    silentAim = false,

    antiFling = false,
}

-- ==========================================================
-- 飞行对象
-- ==========================================================

local flyBodyVelocity = nil
local flyBodyGyro = nil

local function removeFlyObjects()
    if flyBodyVelocity then
        pcall(function()
            flyBodyVelocity:Destroy()
        end)
        flyBodyVelocity = nil
    end

    if flyBodyGyro then
        pcall(function()
            flyBodyGyro:Destroy()
        end)
        flyBodyGyro = nil
    end
end

local function createFlyObjects(hrp)
    removeFlyObjects()

    if not hrp then
        return
    end

    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.Name = "PaperFlyVelocity"
    flyBodyVelocity.MaxForce = Vector3.new(
        math.huge,
        math.huge,
        math.huge
    )
    flyBodyVelocity.P = 9000
    flyBodyVelocity.Velocity = Vector3.zero
    flyBodyVelocity.Parent = hrp

    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.Name = "PaperFlyGyro"
    flyBodyGyro.MaxTorque = Vector3.new(
        math.huge,
        math.huge,
        math.huge
    )
    flyBodyGyro.P = 9000
    flyBodyGyro.D = 500
    flyBodyGyro.CFrame = hrp.CFrame
    flyBodyGyro.Parent = hrp
end

-- ==========================================================
-- Silent Aim
-- ==========================================================

local function getClosestTarget()
    local camera = Workspace.CurrentCamera

    if not camera then
        return nil
    end

    local closestHead = nil
    local closestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character

            if character then
                local humanoid =
                    character:FindFirstChildOfClass("Humanoid")

                local head =
                    character:FindFirstChild("Head")

                if humanoid and head and humanoid.Health > 0 then
                    local distance =
                        (head.Position - camera.CFrame.Position).Magnitude

                    if distance < closestDistance then
                        closestDistance = distance
                        closestHead = head
                    end
                end
            end
        end
    end

    return closestHead
end

-- ==========================================================
-- Silent Aim Hook
-- ==========================================================

local hookInstalled = false

pcall(function()

    if hookmetamethod and newcclosure and getnamecallmethod then

        local oldNamecall

        oldNamecall = hookmetamethod(
            game,
            "__namecall",
            newcclosure(function(self, ...)

                local method = getnamecallmethod()
                local args = {...}

                if settings.silentAim
                    and not checkcaller()
                    and method == "Raycast"
                    and typeof(args[1]) == "Vector3"
                    and typeof(args[2]) == "Vector3"
                then

                    local targetHead = getClosestTarget()

                    if targetHead then

                        local origin = args[1]
                        local direction =
                            targetHead.Position - origin

                        if direction.Magnitude > 0 then
                            args[2] = direction

                            return oldNamecall(
                                self,
                                unpack(args)
                            )
                        end
                    end
                end

                return oldNamecall(
                    self,
                    unpack(args)
                )
            end)
        )

        hookInstalled = true
    end
end)

