-- ==========================================================
-- 天空跳跃
-- ==========================================================

UserInputService.JumpRequest:Connect(function()

    if not settings.skyJump then
        return
    end

    local character = LocalPlayer.Character

    if not character then
        return
    end

    local hrp =
        character:FindFirstChild("HumanoidRootPart")

    if not hrp then
        return
    end

    local velocity = hrp.AssemblyLinearVelocity

    hrp.AssemblyLinearVelocity = Vector3.new(
        velocity.X,
        65,
        velocity.Z
    )
end)

-- ==========================================================
-- 主运行循环
-- ==========================================================

RunService.RenderStepped:Connect(function()

    local character = LocalPlayer.Character

    if not character then
        removeFlyObjects()
        return
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    local hrp =
        character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not hrp then
        return
    end

    local camera =
        Workspace.CurrentCamera

    -- ======================================================
    -- 穿墙
    -- ======================================================

    if settings.noclip then

        for _, object in ipairs(character:GetDescendants()) do

            if object:IsA("BasePart") then
                object.CanCollide = false
            end

        end

    end

    -- ======================================================
    -- 速度
    -- ======================================================

    if settings.speedHack then
        humanoid.WalkSpeed = settings.walkSpeed
    else
        if humanoid.WalkSpeed > 16 then
            humanoid.WalkSpeed = 16
        end
    end

    -- ======================================================
    -- 飞行
    -- ======================================================

    if settings.flyEnabled and camera then

        if not flyBodyVelocity
            or not flyBodyVelocity.Parent
            or not flyBodyGyro
            or not flyBodyGyro.Parent
        then
            createFlyObjects(hrp)
        end

        if flyBodyVelocity and flyBodyGyro then

            local moveDirection = Vector3.zero

            local forward =
                camera.CFrame.LookVector

            local right =
                camera.CFrame.RightVector

            if UserInputService:IsKeyDown(
                Enum.KeyCode.W
            ) then
                moveDirection += forward
            end

            if UserInputService:IsKeyDown(
                Enum.KeyCode.S
            ) then
                moveDirection -= forward
            end

            if UserInputService:IsKeyDown(
                Enum.KeyCode.A
            ) then
                moveDirection -= right
            end

            if UserInputService:IsKeyDown(
                Enum.KeyCode.D
            ) then
                moveDirection += right
            end

            if UserInputService:IsKeyDown(
                Enum.KeyCode.Space
            ) then
                moveDirection += Vector3.new(
                    0,
                    1,
                    0
                )
            end

            if UserInputService:IsKeyDown(
                Enum.KeyCode.LeftControl
            ) then
                moveDirection -= Vector3.new(
                    0,
                    1,
                    0
                )
            end

            if moveDirection.Magnitude > 0 then

                moveDirection =
                    moveDirection.Unit

                flyBodyVelocity.Velocity =
                    moveDirection *
                    settings.flySpeed

            else

                flyBodyVelocity.Velocity =
                    Vector3.zero

            end

            flyBodyGyro.CFrame =
                CFrame.lookAt(
                    hrp.Position,
                    hrp.Position +
                    camera.CFrame.LookVector
                )
        end

    else

        removeFlyObjects()

    end

    -- ======================================================
    -- 陀螺自转
    -- ======================================================

    if settings.spinBot then

        hrp.CFrame =
            hrp.CFrame *
            CFrame.Angles(
                0,
                math.rad(30),
                0
            )

    end

    -- ======================================================
    -- 防甩飞
    -- ======================================================

    if settings.antiFling then

        for _, player in ipairs(
            Players:GetPlayers()
        ) do

            if player ~= LocalPlayer then

                local otherCharacter =
                    player.Character

                if otherCharacter then

                    local otherRoot =
                        otherCharacter:FindFirstChild(
                            "HumanoidRootPart"
                        )

                    if otherRoot then

                        if otherRoot.AssemblyAngularVelocity.Magnitude > 50 then
                            pcall(function()
                                otherRoot.AssemblyAngularVelocity =
                                    Vector3.zero
                            end)
                        end

                    end
                end
            end
        end
    end
end)

-- ==========================================================
-- 角色重生处理
-- ==========================================================

LocalPlayer.CharacterAdded:Connect(function()

    removeFlyObjects()

    task.wait(1)

    if settings.flyEnabled then

        local character =
            LocalPlayer.Character

        local hrp =
            character and
            character:FindFirstChild(
                "HumanoidRootPart"
            )

        if hrp then
            createFlyObjects(hrp)
        end
    end
end)

-- ==========================================================
-- 清理
-- ==========================================================

LocalPlayer.CharacterRemoving:Connect(function()
    removeFlyObjects()
end)

-- ==========================================================
-- 完成
-- ==========================================================

pcall(function()

    zhiUI:Notify(
        "纸.脚本中心v2",
        "脚本中心加载完成",
        3
    )

end)