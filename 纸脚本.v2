GeneralTab:AddToggle("开启加速", false, function(state) settings.speedHack = state end)
GeneralTab:AddToggle("天空跳跃", false, function(state) settings.skyJump = state end)
GeneralTab:AddToggle("陀螺自转", false, function(state) settings.spinBot = state end)
GeneralTab:AddToggle("子弹追踪", false, function(state) settings.silentAim = state end)
GeneralTab:AddToggle("防甩飞", false, function(state) settings.antiFling = state end)

-- Tab 2: 专属游戏
