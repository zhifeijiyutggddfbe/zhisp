-- 加载防HTTPSpy保护器
loadstring(game:HttpGet("https://raw.githubusercontent.com/zhifeijiyutggddfbe/zhisp/refs/heads/main/%E7%BA%B8.antihttpspy"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Camera = Workspace.CurrentCamera

local LocalPlayer = Players.LocalPlayer

-- 加载 zhiUI 界面框架
local zhiUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/yda66722-hash/zhiUI/refs/heads/main/zhiUI"))()

-- ==========================================================
-- 全局设置与变量配置
-- ==========================================================
local settings = {
    flyEnabled = false,
    flySpeed = 50,
    noclip = false,
    speedHack = false,
    walkSpeed = 100,
    skyJump = false,
    spinBot = false,
    silentAim = false,
    antiFling = false,
}

local flyBodyVelocity = nil
local flyBodyGyro = nil

-- 子弹追踪 Hook
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    if method == "Raycast" and not checkcaller() and settings.silentAim then
        local origin = args[1] or Camera.CFrame.Position
        local target = nil
        local dist = math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
                local d = (p.Character.Head.Position - Camera.CFrame.Position).Magnitude
                if d < dist then target = p.Character.Head dist = d end
            end
        end
        if target then return {Instance = target, Position = target.Position, Normal = (origin - target.Position).Unit, Material = Enum.Material.Plastic, Distance = (target.Position - origin).Magnitude} end
    end
    return oldNamecall(self, ...)
end))

-- ==========================================================
-- 1. 构建 zhiUI 窗口与 Tab 分页
-- ==========================================================
local Window = zhiUI:CreateWindow({Title = "纸.脚本中心v2"})

local GeneralTab  = Window:AddTab("通用")
local ExclusiveTab = Window:AddTab("专属游戏")
local ToolTab = Window:AddTab("工具与其他")

