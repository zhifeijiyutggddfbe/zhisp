local vflyEnabled = false
local flySpeed = 50

SettingTab:AddToggle('开启 vfly (飞行)', false, function(state)
    vflyEnabled = state
    zhiUI:Notify("vfly 飞行", state and "飞行模式已开启（方向键控制）" or "飞行模式已关闭", 2)
end)

SettingTab:AddSlider('飞行速度', 10, 200, 50, function(val)
    flySpeed = val
end)

RunService.RenderStepped:Connect(function(deltaTime)
    if not vflyEnabled then return end

    local character = localPlayer.Character
    if not character then return end

    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if humanoid and humanoid.SeatPart then
        local vehicle = humanoid.SeatPart.Parent
        if vehicle and vehicle:IsA("Model") and vehicle.PrimaryPart then
            hrp = vehicle.PrimaryPart
        elseif humanoid.SeatPart:IsA("BasePart") then
            hrp = humanoid.SeatPart
        end
    end

    if not hrp then return end

    local camera = Workspace.CurrentCamera
    if not camera then return end

    local moveDir = Vector3.zero
    local lookCF = camera.CFrame

    if UserInputService:IsKeyDown(Enum.KeyCode.W) then
        moveDir = moveDir + lookCF.LookVector
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then
        moveDir = moveDir - lookCF.LookVector
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then
        moveDir = moveDir - lookCF.RightVector
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then
        moveDir = moveDir + lookCF.RightVector
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
        moveDir = moveDir + Vector3.new(0, 1, 0)
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
        moveDir = moveDir - Vector3.new(0, 1, 0)
    end

    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)

    if moveDir.Magnitude > 0 then
        hrp.CFrame = hrp.CFrame + (moveDir.Unit * flySpeed * deltaTime)
    end
end)

