local function getFlyDirection(camera)

    local direction =
        Vector3.zero

    if UserInputService:IsKeyDown(
        Enum.KeyCode.W
    ) then

        direction +=
            camera.CFrame.LookVector

    end

    if UserInputService:IsKeyDown(
        Enum.KeyCode.S
    ) then

        direction -=
            camera.CFrame.LookVector

    end

    if UserInputService:IsKeyDown(
        Enum.KeyCode.A
    ) then

        direction -=
            camera.CFrame.RightVector

    end

    if UserInputService:IsKeyDown(
        Enum.KeyCode.D
    ) then

        direction +=
            camera.CFrame.RightVector

    end

    if UserInputService:IsKeyDown(
        Enum.KeyCode.Space
    ) then

        direction +=
            Vector3.new(
                0,
                1,
                0
            )

    end

    if UserInputService:IsKeyDown(
        Enum.KeyCode.LeftShift
    ) then

        direction -=
            Vector3.new(
                0,
                1,
                0
            )

    end

    return direction

end

