local TreeHighlights = {}

local function addTreeESP(model)

    if not model
        or TreeHighlights[model]
    then
        return
    end

    if not isTree(model) then
        return
    end

    pcall(function()

        local highlight =
            Instance.new("Highlight")

        highlight.Name =
            "Paper1984_TreeESP"

        highlight.FillColor =
            Color3.fromRGB(
                255,
                0,
                0
            )

        highlight.OutlineColor =
            Color3.fromRGB(
                255,
                255,
                0
            )

        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0

        highlight.DepthMode =
            Enum.HighlightDepthMode.AlwaysOnTop

        highlight.Adornee = model
        highlight.Parent = model

        TreeHighlights[model] =
            highlight

    end)

end

local function clearTreeESP()

    for model, highlight in pairs(
        TreeHighlights
    ) do

        pcall(function()

            if highlight then
                highlight:Destroy()
            end

        end)

    end

    TreeHighlights = {}

end

