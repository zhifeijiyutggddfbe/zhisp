                "HumanoidRootPart"
            )

        if not hrp then
            return
        end

        -- 坐车时尝试控制载具

        if humanoid
            and humanoid.SeatPart
        then

            local seat =
                humanoid.SeatPart

            local vehicle =
                seat.Parent

            if vehicle
                and vehicle:IsA("Model")
                and vehicle.PrimaryPart
            then

                hrp =
                    vehicle.PrimaryPart

            elseif seat:IsA("BasePart") then

                hrp = seat

            end

        end

        local camera =
            Workspace.CurrentCamera

        if not camera then
            return
        end

        local move =
            getFlyDirection(camera)

        pcall(function()

            hrp.AssemblyLinearVelocity =
                Vector3.zero

            hrp.AssemblyAngularVelocity =
                Vector3.zero

        end)

        if move.Magnitude > 0 then

            local offset =
                move.Unit
                * FlySpeed
                * delta

            pcall(function()

                hrp.CFrame =
                    hrp.CFrame
                    + offset

            end)

        end

    end
)

