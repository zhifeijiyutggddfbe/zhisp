local staminaData = {}
local function findAndModifyStamina(modify)
    for _, v in pairs(getgc(true)) do
        if type(v) == "table" and rawget(v, "MaxStamina") and rawget(v, "DrainRate") then
            if not staminaData.original then
                staminaData.original = {
                    DrainRate = v.DrainRate,
                    JumpCost = v.Costs and v.Costs.Jump or 0,
                    ExhaustionTime = v.ExhaustionTime or 0,
                }
            end
            if modify then
                v.DrainRate = 0
                if v.Costs then v.Costs.Jump = 0 end
                v.ExhaustionTime = 0
            else
                if staminaData.original then
                    v.DrainRate = staminaData.original.DrainRate
                    if v.Costs then v.Costs.Jump = staminaData.original.JumpCost end
                    v.ExhaustionTime = staminaData.original.ExhaustionTime
                end
            end
            return true
        end
    end
    return false
end

