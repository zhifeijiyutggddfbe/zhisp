-- 3. 秒砍树逻辑
local autoChopEnabled = false
local CHOP_RANGE = 30
local VALID_TOOL_NAME = "Axe"

GatherTab:AddToggle('开启秒砍树', false, function(state)
    autoChopEnabled = state
    zhiUI:Notify("秒砍树", state and "秒砍功能已开启（拿着斧头点击树木）" or "已关闭秒砍功能", 2)
end)

local function instantChop(treeModel)
    if not (treeModel and treeModel:IsA("Model")) then return end
    task.spawn(function()
        pcall(function()
            if StartWoodcut then StartWoodcut:FireServer(treeModel) end
            task.wait(0.02)
            if TryCut and TryCut:IsA("RemoteFunction") then
                TryCut:InvokeServer(treeModel)
            elseif TryCut and TryCut:IsA("RemoteEvent") then
                TryCut:FireServer(treeModel)
            end
            if StopWoodcut then StopWoodcut:FireServer() end
        end)
    end)
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not autoChopEnabled then return end
    
    local isMouse = input.UserInputType == Enum.UserInputType.MouseButton1
    local isTouch = input.UserInputType == Enum.UserInputType.Touch

    if isMouse or isTouch then
        local character = localPlayer.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return end

        local currentTool = character:FindFirstChildOfClass("Tool")
        if not currentTool or currentTool.Name ~= VALID_TOOL_NAME then return end

        local camera = Workspace.CurrentCamera
        if not camera then return end

        local mousePos = UserInputService:GetMouseLocation()
        local ray = camera:ViewportPointToRay(mousePos.X, mousePos.Y)

        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = { character }

        local result = Workspace:Raycast(ray.Origin, ray.Direction * 150, rayParams)
        if result and result.Instance then
            local target = result.Instance
            local model = target.Parent

            while model and model ~= Workspace do
                if model:IsA("Model") and (model.Name == "Tree" or string.find(model.Name, "Tree") or model.Name == "LumberTree") then
                    break
                end
                model = model.Parent
            end

            if model and model:IsA("Model") then
                local hrp = character.HumanoidRootPart
                if (hrp.Position - target.Position).Magnitude <= CHOP_RANGE then
                    instantChop(model)
                    zhiUI:Notify("秒砍树", "成功对树木发送砍伐请求！", 1)
                end
            end
        end
    end
end)

if CarryAnim then
    local sharedAnim = Instance.new("Animation")
