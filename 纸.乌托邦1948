-- ==========================================
-- 核心功能：无限体力 (利用 getgc 遍历清空消耗)
-- ==========================================
for _, v in pairs(getgc(true)) do
    if type(v) == "table" and rawget(v, "MaxStamina") and rawget(v, "DrainRate") then
        v.DrainRate = 0  
        if v.Costs and v.Costs.Jump then
            v.Costs.Jump = 0 
        end
        v.ExhaustionTime = 0 
    end
end

