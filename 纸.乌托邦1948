-- ==========================================
-- 破解并销毁 HideGrabWhileHolding 限制脚本 (多拿物品)
-- ==========================================
local function disableGrabRestrictionScript()
    pcall(function()
        local playerScripts = localPlayer:FindFirstChild("PlayerScripts")
        if playerScripts then
            local coreFolder = playerScripts:FindFirstChild("Core")
            if coreFolder then
                local targetScript = coreFolder:FindFirstChild("HideGrabWhileHolding")
                if targetScript then
                    targetScript.Disabled = true
                    targetScript:Destroy()
                end
            end
        end
    end)
end

