-- ==========================================
-- 战斗特战 Tab 配置 (高频拳击攻击光环)
-- ==========================================
local punchAuraRunning = false
local punchCooldown = 0.1 

CombatTab:AddToggle('开启攻击光环', false, function(state)
    punchAuraRunning = state
    if state then
        zhiUI:Notify("攻击光环", "拳击自动攻击已开启", 2)
    else
        zhiUI:Notify("攻击光环", "已关闭", 2)
    end
end)

CombatTab:AddSlider('攻击间隔速度 (0.1秒起)', 1, 10, 1, function(val)
    punchCooldown = val * 0.1
end)

-- 攻击光环高频帧循环逻辑
local lastPunchTime = 0
RunService.Heartbeat:Connect(function()
    if punchAuraRunning then
        local currentTime = os.clock()
        if currentTime - lastPunchTime >= punchCooldown then
            lastPunchTime = currentTime
            PunchEvent:FireServer()
        end
    end
end)

