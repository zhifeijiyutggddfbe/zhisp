local function isTree(model)

    if not model
        or not model:IsA("Model")
    then
        return false
    end

    local name = string.lower(
        model.Name
    )

    return
        name == "tree"
        or string.find(name, "tree")
        or name == "lumbertree"

end

local function instantChop(tree)

    if not tree then
        return
    end

    task.spawn(function()

        pcall(function()

            if StartWoodcut then
                StartWoodcut:FireServer(tree)
            end

            task.wait(0.02)

            if TryCut then

                if TryCut:IsA("RemoteFunction") then

                    TryCut:InvokeServer(tree)

                elseif TryCut:IsA("RemoteEvent") then

                    TryCut:FireServer(tree)

                end

            end

            if StopWoodcut then
                StopWoodcut:FireServer()
            end

        end)

    end)

end

local function getTreeFromRaycast(result)

    if not result then
        return nil
    end

    local current =
        result.Instance

    while current
        and current ~= Workspace
    do

        if isTree(current) then
            return current
        end

        current =
            current.Parent

    end

    return nil

end

UserInputService.InputBegan:Connect(
    function(input, gameProcessed)

        if gameProcessed then
            return
        end

        if not State.AutoChop then
            return
        end

        local validInput =
            input.UserInputType
                == Enum.UserInputType.MouseButton1
            or
            input.UserInputType
                == Enum.UserInputType.Touch

        if not validInput then
            return
        end

        local char =
            getCharacter()

        local hrp =
            getHRP()

        if not char or not hrp then
            return
        end

        local tool =
            char:FindFirstChildOfClass("Tool")

        if not tool
            or tool.Name ~= "Axe"
        then
            return
        end

        local camera =
            Workspace.CurrentCamera

        if not camera then
            return
        end

        local position

        if input.UserInputType
            == Enum.UserInputType.Touch
        then

            position = input.Position

        else

            position =
                UserInputService:GetMouseLocation()

        end

        local ray =
            camera:ViewportPointToRay(
                position.X,
                position.Y
            )

        local params =
            RaycastParams.new()

        params.FilterType =
            Enum.RaycastFilterType.Exclude

        params.FilterDescendantsInstances = {
            char
        }

        local result =
            Workspace:Raycast(
                ray.Origin,
                ray.Direction * 150,
                params
            )

        local tree =
            getTreeFromRaycast(result)

        if not tree then
            return
        end

        local hitPart =
            result.Instance

        if hitPart
            and (
                hrp.Position
                - hitPart.Position
            ).Magnitude <= ChopRange
        then

            instantChop(tree)

            Notify(
                "秒砍树",
                "已发送砍树请求",
                1
            )

        end

    end
)

