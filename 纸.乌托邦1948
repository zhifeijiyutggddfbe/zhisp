local StaminaOriginal = nil

local function findAndModifyStamina(enable)

    if type(getgc) ~= "function" then
        return false
    end

    local found = false

    pcall(function()

        for _, v in ipairs(getgc(true)) do

            if type(v) == "table"
                and rawget(v, "MaxStamina")
                and rawget(v, "DrainRate")
            then

                found = true

                if not StaminaOriginal then

                    StaminaOriginal = {
                        DrainRate = v.DrainRate,

                        JumpCost =
                            v.Costs
                            and v.Costs.Jump
                            or 0,

                        ExhaustionTime =
                            v.ExhaustionTime
                            or 0,
                    }

                end

                if enable then

                    v.DrainRate = 0

                    if v.Costs then
                        v.Costs.Jump = 0
                    end

                    v.ExhaustionTime = 0

                else

                    if StaminaOriginal then

                        v.DrainRate =
                            StaminaOriginal.DrainRate

                        if v.Costs then
                            v.Costs.Jump =
                                StaminaOriginal.JumpCost
                        end

                        v.ExhaustionTime =
                            StaminaOriginal.ExhaustionTime

                    end

                end

            end

        end

    end)

    return found

end

