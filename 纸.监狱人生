-- 4. 修复且升级版的弹道生成引擎 (Complete Fixed Tracer Engine)
-- ==========================================================
local function spawnCustomTracer(startPos, endPos, color)
    local shape = settings.tracerShape
    local dist = (startPos - endPos).Magnitude
    if dist <= 0.1 then return end

    if shape == "Beam" then
        local p0 = Instance.new("Part")
        p0.Size = Vector3.new(0.05, 0.05, 0.05)
        p0.Position = startPos
        p0.Anchored = true
        p0.Transparency = 1
        p0.CanCollide = false
        p0.Parent = workspace

        local p1 = Instance.new("Part")
        p1.Size = Vector3.new(0.05, 0.05, 0.05)
        p1.Position = endPos
        p1.Anchored = true
        p1.Transparency = 1
        p1.CanCollide = false
        p1.Parent = workspace

        local a0 = Instance.new("Attachment", p0)
        local a1 = Instance.new("Attachment", p1)

        local beam = Instance.new("Beam", p0)
        beam.Attachment0 = a0
        beam.Attachment1 = a1
        beam.Color = ColorSequence.new(color)
        beam.Width0 = 0.4
        beam.Width1 = 0.05
        beam.Texture = "rbxassetid://446111271"
        beam.TextureMode = Enum.TextureMode.Wrap
        beam.TextureSpeed = 4
        beam.FaceCamera = true

        Debris:AddItem(p0, 0.12)
        Debris:AddItem(p1, 0.12)

    elseif shape == "Cylinder" then
        local cyl = Instance.new("Part")
        cyl.Anchored = true
        cyl.CanCollide = false
        cyl.Material = Enum.Material.Neon
        cyl.Color = color
        cyl.Size = Vector3.new(0.25, dist, 0.25)
        cyl.CFrame = CFrame.new(startPos, endPos) * CFrame.new(0, 0, -dist / 2) * CFrame.Angles(math.rad(90), 0, 0)
        cyl.Parent = workspace
        Debris:AddItem(cyl, 0.1)

    elseif shape == "Rope" then
        local ropePart = Instance.new("Part")
        ropePart.Anchored = true
        ropePart.CanCollide = false
        ropePart.Transparency = 1
        ropePart.Position = startPos
        ropePart.Parent = workspace
        
        local a0 = Instance.new("Attachment", ropePart)
        local a1 = Instance.new("Attachment", ropePart)
        a1.WorldPosition = endPos

        local rope = Instance.new("RopeConstraint", ropePart)
        rope.Attachment0 = a0
        rope.Attachment1 = a1
        rope.Length = dist
        rope.Color = BrickColor.new(color)
        rope.Visible = true
        rope.Thickness = 0.15
        Debris:AddItem(ropePart, 0.1)

    elseif shape == "Particles" then
        local emitterPart = Instance.new("Part")
        emitterPart.Anchored = true
        emitterPart.CanCollide = false
        emitterPart.Transparency = 1
        emitterPart.Size = Vector3.new(0.05, 0.05, dist)
        emitterPart.CFrame = CFrame.new(startPos, endPos) * CFrame.new(0, 0, -dist / 2)
        emitterPart.Parent = workspace

        local pe = Instance.new("ParticleEmitter", emitterPart)
        pe.Texture = "rbxassetid://258122325"
        pe.Color = ColorSequence.new(color)
        pe.Size = NumberSequence.new(0.35, 0)
        pe.Lifetime = NumberRange.new(0.1, 0.2)
        pe.Rate = 250
        pe.Speed = NumberRange.new(3, 6)

        Debris:AddItem(emitterPart, 0.12)

    elseif shape == "Neon Box" then
        local segments = math.clamp(math.floor(dist / 3), 2, 10)
        for i = 0, segments do
            local pos = startPos:Lerp(endPos, i / segments)
            local box = Instance.new("Part")
            box.Anchored = true
            box.CanCollide = false
            box.Material = Enum.Material.Neon
            box.Color = color
            box.Size = Vector3.new(0.3, 0.3, 0.3)
            box.CFrame = CFrame.new(pos) * CFrame.Angles(math.rad(45), math.rad(45), 0)
            box.Parent = workspace
            
            TweenService:Create(box, TweenInfo.new(0.15), {
                Size = Vector3.new(0, 0, 0),
                Transparency = 1
            }):Play()
            Debris:AddItem(box, 0.15)
        end

    elseif shape == "Lightning" then
        local segments = math.clamp(math.floor(dist / 4), 3, 12)
        local lastPt = startPos
        for i = 1, segments do
            local nextPt = (i == segments) and endPos or (startPos:Lerp(endPos, i / segments) + Vector3.new(
                math.random(-15, 15) / 10,
                math.random(-15, 15) / 10,
                math.random(-15, 15) / 10
            ))
            local subDist = (lastPt - nextPt).Magnitude

            local seg = Instance.new("Part")
            seg.Anchored = true
            seg.CanCollide = false
            seg.Material = Enum.Material.Neon
            seg.Color = color
            seg.Size = Vector3.new(0.1, 0.1, subDist)
            seg.CFrame = CFrame.new(lastPt, nextPt) * CFrame.new(0, 0, -subDist / 2)
            seg.Parent = workspace
            Debris:AddItem(seg, 0.08)

            lastPt = nextPt
        end

    elseif shape == "Pulse Rings" then
        local ringCount = math.clamp(math.floor(dist / 5), 2, 8)
        for i = 1, ringCount do
            local pos = startPos:Lerp(endPos, i / ringCount)
            local ring = Instance.new("Part")
            ring.Anchored = true
            ring.CanCollide = false
            ring.Material = Enum.Material.Neon
            ring.Color = color
            ring.Shape = Enum.PartType.Cylinder
            ring.Size = Vector3.new(0.05, 0.4, 0.4)
            ring.CFrame = CFrame.new(startPos, endPos) * CFrame.new(0, 0, -(i / ringCount) * dist) * CFrame.Angles(0, math.rad(90), 0)
            ring.Parent = workspace

            TweenService:Create(ring, TweenInfo.new(0.18), {
                Size = Vector3.new(0.05, 1.8, 1.8),
                Transparency = 1
            }):Play()
            Debris:AddItem(ring, 0.18)
        end

    else
        local laser = Instance.new("Part")
        laser.Anchored = true
        laser.CanCollide = false
        laser.Material = Enum.Material.Neon
        laser.Color = color
        laser.Size = Vector3.new(0.06, 0.06, dist)
        laser.CFrame = CFrame.new(startPos, endPos) * CFrame.new(0, 0, -dist / 2)
        laser.Parent = workspace
        Debris:AddItem(laser, 0.08)
    end
end

