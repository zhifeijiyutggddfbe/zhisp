local function fetchWeapon(gunName)
    local giverFolder = workspace:FindFirstChild("Prison_ITEMS") and workspace.Prison_ITEMS:FindFirstChild("giver")
    if not giverFolder then 
        zhiUI:Notify("错误", "未找到地图给武器区域！", 2)
        return 
    end

    local gunModel = giverFolder:FindFirstChild(gunName)
    if not gunModel then 
        zhiUI:Notify("错误", "找不到武器: " .. gunName, 2)
        return 
    end

    local targetPart = gunModel:FindFirstChildWhichIsA("BasePart", true)
    if not targetPart then return end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local savedPos = hrp.CFrame
        hrp.CFrame = targetPart.CFrame
        task.wait(0.15)

        local interactRemote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("InteractWithItem")
        if interactRemote then
            pcall(function()
                interactRemote:InvokeServer(targetPart)
            end)
        end
        task.wait(0.1)
        hrp.CFrame = savedPos
        zhiUI:Notify("成功", "已成功获取 " .. gunName, 2)
    end
end

