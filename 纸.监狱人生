local function isVisible(myHead, targetHead, targetChar)
    if not settings.wallCheck then return true end

    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    raycastParams.IgnoreWater = true

    local origin = myHead.Position
    local direction = targetHead.Position - origin
    local result = workspace:Raycast(origin, direction, raycastParams)

    if not result or result.Instance:IsDescendantOf(targetChar) then
        return true
    end
    return false
end

-- 获取适合的目标（白名单过滤）
local function getNearest(maxDist)
    maxDist = maxDist or 1500
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") or not myChar:FindFirstChild("Head") then return nil end
    
    local myHead = myChar.Head
    local myPos = myChar.HumanoidRootPart.Position
    local nearest, minDist = nil, maxDist

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") and plr.Character:FindFirstChildOfClass("Humanoid") then
            local plrTeam = plr.Team and plr.Team.Name or ""
            
            if ProtectedTeams[plrTeam] == true then
                continue
            end

            local targetHead = plr.Character.Head
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")

            if hum.Health > 0 then
                local dist = (targetHead.Position - myPos).Magnitude
                if dist < minDist then
                    if isVisible(myHead, targetHead, plr.Character) then
                        nearest = plr
                        minDist = dist
                    end
                end
            end
        end
    end
    return nearest
end

local function getToolAmmo(tool)
    if not tool then return nil end
    local ammoVal = tool:FindFirstChild("CurrentAmmo")
    if ammoVal and (ammoVal:IsA("IntValue") or ammoVal:IsA("NumberValue")) then
        return ammoVal.Value
    end
    return tool:GetAttribute("CurrentAmmo")
end

local function applyRainbowRecursive(object, color)
    for _, child in ipairs(object:GetChildren()) do
        if child:IsA("BasePart") then
            child.Material = Enum.Material.Glass
            child.Color = color
            child.Transparency = 0.2
        end
        applyRainbowRecursive(child, color)
    end
end

RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end

    if settings.noclip then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = settings.speedHack and 35 or 16
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if settings.spinBot and hrp then
        hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(45), 0)
    end
end)

RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end

    local tool = char:FindFirstChildOfClass("Tool")
    local currentAmmo = getToolAmmo(tool)

    -- 1. 秒杀拳击（白名单过滤）
    if settings.fastPunch and MeleeEvent then
        local punchTarget = getNearest(15)
        if punchTarget then
            pcall(function()
                MeleeEvent:FireServer(punchTarget, 1, 1)
            end)
        end
    end

    -- 2. 弹药监控 & 自动换弹
    if tool and currentAmmo ~= nil then
        AmmoText.Text = "AMMO: " .. tostring(currentAmmo)
        if settings.autoReload and currentAmmo <= 0 and not isReloading then
            isReloading = true
            AmmoText.Text = "RELOADING"
            AmmoText.TextColor3 = Color3.fromRGB(255, 170, 0)
            
            task.spawn(function()
                pcall(function() ReloadRemote:InvokeServer() end)
                task.wait(1.5)
                isReloading = false
                AmmoText.TextColor3 = Color3.fromRGB(0, 200, 255)
            end)
        end
    else
        AmmoText.Text = "AMMO: --"
        AmmoText.TextColor3 = Color3.fromRGB(0, 200, 255)
    end

    -- 3. 彩色物品
    if settings.rainbowItems then
        local rainbowColor = getRainbowColor()
        local containers = {char, LocalPlayer:FindFirstChild("Backpack")}

        for _, container in ipairs(containers) do
            if container then
                for _, item in ipairs(container:GetChildren()) do
                    if item:IsA("Tool") then
                        applyRainbowRecursive(item, rainbowColor)
                    end
                end
            end
        end
    end

    -- 4. 静默自瞄 & 优化视觉子弹轨迹
    if settings.silentAim then
        local target = getNearest(1500)
        if target and tool then
            local targetHead = target.Character.Head
            local myHrp = char:FindFirstChild("HumanoidRootPart")
            if not myHrp then return end

            if currentAmmo == nil or currentAmmo > 0 then
                pcall(function()
                    ShootEvent:FireServer({{myHrp.Position, targetHead.Position, targetHead}})
                end)

                local now = tick()
                if not lastHitLog[target.Name] or (now - lastHitLog[target.Name] > 0.2) then
                    lastHitLog[target.Name] = now
                    addHitLog(LocalPlayer.Name, target.Name, tool.Name)
                end

                -- 动态渲染弹道
                if settings.visualTracers then
                    local color = LaserColors[settings.tracerColorName] or LaserColors["Blue"]
                    if settings.tracerColorName == "Rainbow" then
