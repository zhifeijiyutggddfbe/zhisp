-- 1. 远程加载 zhiUI 库
local zhiUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/yda66722-hash/zhiUI/refs/heads/main/zhiUI"))()

-- 2. 服务与变量定义
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")

local Events = ReplicatedStorage:WaitForChild("Events")
local FishingEvent = Events:WaitForChild("Fishing")
local UseSkillEvent = Events:WaitForChild("UseSkill")
local DialogueEvent = Events:WaitForChild("ChooseDialogueOption")
local BuyRodEvent = Events:WaitForChild("BuyFishingRod")
local MainGui = LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("MainGui")

-- 全局控制开关与设置
_G.AutoFishing = false
_G.AutoSkills = false
_G.SelectedSkills = {
    ["Z"] = true,
    ["X"] = true,
    ["C"] = true,
    ["V"] = true
}

local hasCast = false

-- 3. 核心辅助函数与工具函数
local function isFishingGuiVisible()
    local fishingGui = MainGui:FindFirstChild("Fishing")
    return fishingGui and fishingGui.Visible
end

local function isFishing()
    if Character and Character:GetAttribute("Fishing") then
        return not Character:GetAttribute("Retractable")
    end
    return false
end

-- 传送函数
local function TeleportToPos(x, y, z)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = CFrame.new(x, y, z)
    end
end

-- 一键出售全部鱼
local function SellAllFish()
    local sellEvent = Events:FindFirstChild("SellFish")
    if sellEvent then
        sellEvent:FireServer("All")
    end
end

-- 4. 事件监听与角色重载
if MainGui:FindFirstChild("Fishing") then
    MainGui.Fishing:GetPropertyChangedSignal("Visible"):Connect(function()
        hasCast = isFishingGuiVisible()
    end)
end

LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    Character = newCharacter
    HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")
    hasCast = false
end)

-- 5. 钓鱼后台循环与响应逻辑

-- 5.1 自动抛竿
task.spawn(function()
    while true do
        task.wait(0.5)
        if _G.AutoFishing and not isFishingGuiVisible() and not isFishing() then
            if not hasCast then
                hasCast = true
                FishingEvent:FireServer(HumanoidRootPart.CFrame)
            end
        end
    end
end)

-- 5.2 自动锁定绿条位置
task.spawn(function()
    while true do
        task.wait(0.01)
        if _G.AutoFishing and isFishingGuiVisible() then
            local fishingGui = MainGui:FindFirstChild("Fishing")
            if fishingGui and fishingGui.Visible then
                local bar = fishingGui:FindFirstChild("BarFrame") and fishingGui.BarFrame:FindFirstChild("Bar")
                if bar then
                    pcall(function()
                        bar.Position = UDim2.new(0.5, 0, bar.Position.Y.Scale, bar.Position.Y.Offset)
                    end)
                end
            end
        end
    end
end)

-- 5.3 Slam (重击 QTE) 响应
if Events:FindFirstChild("Slam") then
    Events.Slam.OnClientEvent:Connect(function()
        if not _G.AutoFishing then return end
        task.spawn(function()
            local start = tick()
            while tick() - start < 2 do
                local fishingGui = MainGui:FindFirstChild("Fishing")
                local trashCan = fishingGui and fishingGui:FindFirstChild("TrashCan")
                local slamBtn = trashCan and trashCan:FindFirstChild("Slam")
                
                if slamBtn and slamBtn:FindFirstChild("Button") and slamBtn.Button:FindFirstChild("Line") then
                    if slamBtn.Button.Line.Size.X.Scale < 1.15 then
                        task.wait(0.05)
                        pcall(function() slamBtn.Button.MouseButton1Click:Fire() end)
                        return
                    end
                end
                task.wait(0.03)
            end
        end)
    end)
end

-- 5.4 Charge (蓄力 QTE) 响应
if Events:FindFirstChild("Charge") then
    Events.Charge.OnClientEvent:Connect(function()
        if not _G.AutoFishing then return end
        task.wait(0.1)
        local fishingGui = MainGui:FindFirstChild("Fishing")
        local trashCan = fishingGui and fishingGui:FindFirstChild("TrashCan")
        local chargeBtn = trashCan and trashCan:FindFirstChild("Charge")
        if chargeBtn and chargeBtn:FindFirstChild("Button") then
            pcall(function() chargeBtn.Button.MouseButton1Click:Fire() end)
        end
    end)
end

-- 5.5 自动释放技能循环
task.spawn(function()
    while true do
        task.wait(1)
        local fishingGui = MainGui:FindFirstChild("Fishing")
        
        if _G.AutoSkills and fishingGui and fishingGui.Visible then
            for skill, enabled in pairs(_G.SelectedSkills) do
                if enabled then
                    UseSkillEvent:FireServer(skill)
                    task.wait(0.1)
                end
            end
        end
    end
end)

