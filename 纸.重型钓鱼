end)

MainTab:AddToggle("释放X技能", true, function(state)
    _G.SelectedSkills["X"] = state
end)

MainTab:AddToggle("释放C技能", true, function(state)
    _G.SelectedSkills["C"] = state
end)

MainTab:AddToggle("释放V技能", true, function(state)
    _G.SelectedSkills["V"] = state
end)

