local UtilityTab = Window:AddTab("面板")

UtilityTab:AddDropdown("功能操作", {
    "一键出售全部鱼",
    "打开购买鱼竿面板",
    "打开制造鱼竿面板",
    "打开购买诱饵面板",
    "打开制造诱饵面板",
    "购买克拉肯干钓竿"
}, function(selected)
    if selected == "一键出售全部鱼" then
        SellAllFish()
    elseif selected == "打开购买鱼竿面板" then
        DialogueEvent:FireServer("BuyFishingRod", 1, "BuyRod")
    elseif selected == "打开制造鱼竿面板" then
        DialogueEvent:FireServer("BuyFishingRod", 2, "CraftRod")
    elseif selected == "打开购买诱饵面板" then
        DialogueEvent:FireServer("BuyBait", 1, "BaitShop")
    elseif selected == "打开制造诱饵面板" then
        DialogueEvent:FireServer("BuyBait", 2, "CraftBait")
    elseif selected == "购买克拉肯干钓竿" then
        BuyRodEvent:FireServer("Kraken Rod")
    end
end)