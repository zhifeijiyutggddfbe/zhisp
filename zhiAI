local function CreateCodeCard( codeContent, parent )

local lineCount =
    1

for _ in codeContent:gmatch("\n") do
    lineCount += 1
end

local height =
    math.clamp(
        95 + lineCount * 2,
        110,
        420
    )

local frame =
    Instance.new("Frame")

frame.Size =
    UDim2.new(
        1,
        0,
        0,
        height
    )

frame.BackgroundColor3 =
    Color3.fromRGB(
        11,
        11,
        15
    )

frame.BorderSizePixel =
    0

frame.Parent =
    parent

Instance.new(
    "UICorner",
    frame
).CornerRadius =
    UDim.new(
        0,
        6
    )

local box =
    Instance.new("TextBox")

box.Size =
    UDim2.new(
        1,
        -12,
        1,
        -36
    )

box.Position =
    UDim2.fromOffset(
        6,
        6
    )

box.BackgroundTransparency =
    1

box.ClearTextOnFocus =
    false

box.MultiLine =
    true

box.TextEditable =
    true

box.Text =
    codeContent

box.TextColor3 =
    Color3.fromRGB(
        0,
        255,
        127
    )

box.Font =
    Enum.Font.Code

box.TextSize =
    10

box.TextXAlignment =
    Enum.TextXAlignment.Left

box.TextYAlignment =
    Enum.TextYAlignment.Top

box.Parent =
    frame

local copyBtn =
    Instance.new("TextButton")

copyBtn.Size =
    UDim2.new(
        0.48,
        0,
        0,
        24
    )

copyBtn.Position =
    UDim2.new(
        0,
        6,
        1,
        -30
    )

copyBtn.Text =
    "📋 复制完整代码"

copyBtn.Font =
    Enum.Font.GothamBold

copyBtn.TextSize =
    10

copyBtn.TextColor3 =
    Color3.fromRGB(
        255,
        255,
        255
    )

copyBtn.BackgroundColor3 =
    Color3.fromRGB(
        45,
        45,
        55
    )

copyBtn.Parent =
    frame

Instance.new(
    "UICorner",
    copyBtn
).CornerRadius =
    UDim.new(
        0,
        4
    )

copyBtn.MouseButton1Click:Connect(
    function()

        if not setclipboard then
            copyBtn.Text =
                "当前环境不支持复制"
            return
        end

        local success =
            pcall(
                function()
                    setclipboard(codeContent)
                end
            )

        if success then

            copyBtn.Text =
                "✓ 已复制完整代码"

            task.delay(
                1.5,
                function()

                    if copyBtn.Parent then
                        copyBtn.Text =
                            "📋 复制完整代码"
                    end

                end
            )

        else
            copyBtn.Text =
                "复制失败"
        end
    end
)

return frame

end

local function AddMessage( text, isUser )

local msgFrame =
    Instance.new("Frame")

msgFrame.Size =
    UDim2.new(
        1,
        0,
        0,
        0
    )

msgFrame.AutomaticSize =
    Enum.AutomaticSize.Y

msgFrame.BackgroundTransparency =
    1

msgFrame.Parent =
    ScrollFrame

local codeContent =
    text:match(
        "```[%w_%-]*\n(.-)```"
    )

if not codeContent then
    codeContent =
        text:match(
            "```(.-)```"
        )
end

local cleanText =
    text

if codeContent then
    cleanText =
        text:gsub(
            "```[%w_%-]*\n.-```",
            "💻 代码已放入下方代码卡片"
        )

    cleanText =
        cleanText:gsub(
            "```.-```",
            "💻 代码已放入下方代码卡片"
        )
end

local layout =
    Instance.new(
        "UIListLayout",
        msgFrame
    )

layout.Padding =
    UDim.new(
        0,
        6
    )

layout.HorizontalAlignment =
    isUser
    and Enum.HorizontalAlignment.Right
    or Enum.HorizontalAlignment.Left

local bubble =
    Instance.new("TextLabel")

bubble.Size =
    UDim2.new(
        0,
        math.min(
            390,
            math.max(
                180,
                #cleanText * 5
            )
        ),
        0,
        0
    )

bubble.AutomaticSize =
    Enum.AutomaticSize.Y

bubble.Text =
    cleanText

bubble.TextWrapped =
    true

bubble.BackgroundColor3 =
    isUser
    and Color3.fromRGB(
        0,
        105,
        220
    )
    or Color3.fromRGB(
        38,
        38,
        48
    )

bubble.TextColor3 =
    Color3.fromRGB(
        240,
        240,
        240
    )

bubble.Font =
    Enum.Font.Gotham

bubble.TextSize =
    11

bubble.TextXAlignment =
    Enum.TextXAlignment.Left

bubble.TextYAlignment =
    Enum.TextYAlignment.Top

bubble.Parent =
    msgFrame

Instance.new(
    "UICorner",
    bubble
).CornerRadius =
    UDim.new(
        0,
        6
    )

local padding =
    Instance.new(
        "UIPadding",
        bubble
    )

padding.PaddingTop =
    UDim.new(
        0,
        7
    )

padding.PaddingBottom =
    UDim.new(
        0,
        7
    )

padding.PaddingLeft =
    UDim.new(
        0,
        9
    )

padding.PaddingRight =
    UDim.new(
        0,
        9
    )

if not isUser and codeContent then
    CreateCodeCard(
        codeContent,
        msgFrame
    )
end

return msgFrame

end

