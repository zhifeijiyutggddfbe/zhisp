-- ================================================================ -- 发送 -- ================================================================

local IsProcessing = false

local function SendMessage()

if IsProcessing then
    return
end

local userMsg =
    ChatInput.Text

if not userMsg
    or userMsg:gsub("%s+", "") == "" then
    return
end

ChatInput.Text = ""

IsProcessing =
    true

SendBtn.Text =
    "..."

AddMessage(
    userMsg,
    true
)

local loading =
    AddMessage(
        "⏳ zhiai Luau Master 正在分析需求、游戏上下文以及 zhiUI 架构...",
        false
    )

task.spawn(
    function()

        local gameContext =
            ScanGameLogic()

        local prompt =
            table.concat(
                {
                    "【当前游戏上下文】",
                    gameContext,
                    "",
                    "【用户需求】",
                    userMsg,
                    "",
                    "【执行规则】",
                    "1. 分析需求后再生成代码。",
                    "2. 涉及 UI 时必须使用 zhiUI。",
                    "3. 必须按照 zhiUI API 规范生成。",
                    "4. 不要编造不存在的 zhiUI API。",
                    "5. 需要游戏对象时必须根据上下文判断。",
                    "6. 必须处理 nil、连接生命周期以及错误。",
                    "7. 如果用户要求完整脚本，输出完整脚本。",
                    "8. 只输出一个 ```lua``` 代码块。",
                    "9. 不要在代码块外添加解释。"
                },
                "\n"
            )

        table.insert(
            History,
            {
                role = "user",
                content = prompt
            }
        )

        local success, response =
            pcall(
                function()

                    return requestFunc(
                        {
                            Url =
                                "https://openrouter.ai/api/v1/chat/completions",

                            Method =
                                "POST",

                            Headers =
                                {
                                    ["Content-Type"] =
                                        "application/json",

                                    ["Authorization"] =
                                        "Bearer "
                                        .. API_KEY
                                },

                            Body =
                                HttpService:JSONEncode(
                                    {
                                        model =
                                            "openrouter/free",

                                        messages =
                                            History
                                    }
                                )
                        }
                    )
                end
            )

        if loading
            and loading.Parent then

            loading:Destroy()
        end

        if not success
            or not response then

            AddMessage(
                "❌ HTTP 请求失败。",
                false
            )

            IsProcessing =
                false

            SendBtn.Text =
                "发送"

            return
        end

        local body =
            response.Body

        if type(body) ~= "string" then

            AddMessage(
                "❌ HTTP 返回数据无效。",
                false
            )

            IsProcessing =
                false

            SendBtn.Text =
                "发送"

            return
        end

        local decodeSuccess,
            data =
            pcall(
                function()
                    return HttpService:JSONDecode(
                        body
                    )
                end
            )

        if not decodeSuccess
            or type(data) ~= "table" then

            AddMessage(
                "❌ JSON 解析失败。",
                false
            )

            IsProcessing =
                false

            SendBtn.Text =
                "发送"

            return
        end

        local reply

        pcall(
            function()

                reply =
                    data
                    .choices
                    and data.choices[1]
                    and data.choices[1].message
                    and data.choices[1].message.content
            end
        )

        if type(reply) ~= "string"
            or reply == "" then

            local errorText =
                "❌ AI 没有返回有效内容。"

            if data.error
                and data.error.message then

                errorText =
                    errorText
                    .. "\n"
                    .. tostring(
                        data.error.message
                    )
            end

            AddMessage(
                errorText,
                false
            )

            IsProcessing =
                false

            SendBtn.Text =
                "发送"

            return
        end

        -- 修正历史：
        -- 发给 AI 的 prompt 只用于上下文，
        -- 后续历史保持真实用户消息。
        History[#History].content =
            userMsg

        table.insert(
            History,
            {
                role = "assistant",
                content = reply
            }
        )

        AddMessage(
            reply,
            false
        )

        IsProcessing =
            false

        SendBtn.Text =
            "发送"
    end
)

end

SendBtn.MouseButton1Click:Connect( SendMessage )

ChatInput.FocusLost:Connect( function(enterPressed)

if enterPressed then
        SendMessage()
    end
end

)

