-- 3. 核心功能函数
local function BringItem(itemName)
    local inventory = LocalPlayer:FindFirstChild("Inventory")
    local itemsFolder = workspace:FindFirstChild("Items")
    local RemoteEvents = ReplicatedStorage:FindFirstChild("RemoteEvents")
    local RequestBagStoreItem = RemoteEvents and RemoteEvents:FindFirstChild("RequestBagStoreItem")
    local RequestBagDropItem = RemoteEvents and RemoteEvents:FindFirstChild("RequestBagDropItem")

    if not (inventory and itemsFolder and RequestBagStoreItem and RequestBagDropItem) then
        return
    end

    for _, invItem in pairs(inventory:GetChildren()) do
        for _, mapItem in ipairs(itemsFolder:GetChildren()) do
            if mapItem.Name == itemName then
                RequestBagStoreItem:InvokeServer(invItem, mapItem)
            end
        end
    end

    task.wait(0.1)

    for _, invItem in pairs(inventory:GetChildren()) do
        local targetItem = itemsFolder:FindFirstChild(itemName)
        if targetItem then
            RequestBagDropItem:FireServer(invItem, targetItem, true)
        end
    end
end

local function PlantTreesInCircle()
    local RemoteEvents = ReplicatedStorage:FindFirstChild("RemoteEvents")
    local plantRemote = RemoteEvents and RemoteEvents:FindFirstChild("RequestPlantItem")
    local itemsFolder = workspace:FindFirstChild("Items")
    local sapling = itemsFolder and itemsFolder:FindFirstChild("Sapling")
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")

    if not (plantRemote and sapling and rootPart) then
        return
    end

    for angle = 0, 350, ChopConfig.PlantAngleStep do
        local angleRad = math.rad(angle)
        local x = rootPart.Position.X + ChopConfig.PlantRadius * math.cos(angleRad)
        local z = rootPart.Position.Z + ChopConfig.PlantRadius * math.sin(angleRad)
        local targetPos = Vector3.new(x, ChopConfig.PlantYOffset, z)

        plantRemote:InvokeServer(sapling, targetPos)
        task.wait(0.1)
    end
end

-- 4. 后台循环逻辑

-- 战斗逻辑：杀戮光环
task.spawn(function()
    while true do
        if CombatToggles.KillAura then
            local character = LocalPlayer.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            local toolHandle = character and character:FindFirstChild("ToolHandle")
            local RemoteEvents = ReplicatedStorage:FindFirstChild("RemoteEvents")
            local attackRemote = RemoteEvents and RemoteEvents:FindFirstChild("ToolDamageObject")

            if character and rootPart and toolHandle and attackRemote then
                local currentTool = toolHandle:FindFirstChild("OriginalItem") and toolHandle.OriginalItem.Value
                if currentTool and ValidWeapons[currentTool.Name] then
                    local charactersFolder = workspace:FindFirstChild("Characters")
                    if charactersFolder then
                        for _, enemy in pairs(charactersFolder:GetChildren()) do
                            if enemy:IsA("Model") 
                               and enemy ~= character 
                               and enemy:FindFirstChild("HumanoidRootPart") 
                               and enemy:FindFirstChild("HitRegisters") 
                            then
                                local distance = (rootPart.Position - enemy.HumanoidRootPart.Position).Magnitude
                                if distance <= 100 then
                                    attackRemote:InvokeServer(enemy, currentTool, true, rootPart.CFrame)
                                end
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.6)
    end
end)

-- 战斗逻辑：自动击晕鹿
task.spawn(function()
    while true do
        if CombatToggles.AutoStunDeer then
            local RemoteEvents = ReplicatedStorage:FindFirstChild("RemoteEvents")
            local stunRemote = RemoteEvents and RemoteEvents:FindFirstChild("MonsterHitByTorch")
            local charactersFolder = workspace:FindFirstChild("Characters")
            local deer = charactersFolder and charactersFolder:FindFirstChild("Deer")

            if stunRemote and deer then
                stunRemote:InvokeServer(deer)
            end
        end
        task.wait(0.5)
    end
end)

-- 伐木逻辑：自动砍树
task.spawn(function()
    while true do
        if ChopConfig.AutoChop then
            local character = LocalPlayer.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            local toolHandle = character and character:FindFirstChild("ToolHandle")
            local RemoteEvents = ReplicatedStorage:FindFirstChild("RemoteEvents")
            local chopRemote = RemoteEvents and RemoteEvents:FindFirstChild("ToolDamageObject")

            if character and rootPart and toolHandle and chopRemote then
                local currentTool = toolHandle:FindFirstChild("OriginalItem") and toolHandle.OriginalItem.Value
                if currentTool and ValidAxes[currentTool.Name] then
                    local mapFolder = workspace:FindFirstChild("Map")
                    local treePaths = {
                        mapFolder and mapFolder:FindFirstChild("Foliage"),
                        mapFolder and mapFolder:FindFirstChild("Landmarks")
                    }

                    for _, path in ipairs(treePaths) do
                        if path then
                            for _, tree in ipairs(path:GetChildren()) do
                                local isValidTree = table.find({"Small Tree", "TreeBig1", "TreeBig2", "TreeBig3"}, tree.Name) ~= nil
                                if tree:IsA("Model") and isValidTree and tree:FindFirstChild("HitRegisters") then
                                    local treePart = tree:FindFirstChild("Trunk") or tree:FindFirstChild("HumanoidRootPart") or tree.PrimaryPart
                                    if treePart then
                                        local distance = (rootPart.Position - treePart.Position).Magnitude
                                        if distance <= 100 then
                                            chopRemote:InvokeServer(tree, currentTool, true, rootPart.CFrame)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.7)
    end
end)

-- 环境逻辑：高频保持全亮 (防止游戏服务器重置时间/迷雾)
task.spawn(function()
    while true do
        if EnvConfig.Fullbright then
            Lighting.Brightness = 2
            Lighting.ClockTime = 14
            Lighting.FogEnd = 100000
            Lighting.GlobalShadows = false
            Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
        end
        task.wait(0.5)
    end
end)

