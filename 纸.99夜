MainTab:AddButton("开启无限锁血", function()

    pcall(function()

        local remote =
            ReplicatedStorage:FindFirstChild("RemoteEvents")
            and ReplicatedStorage.RemoteEvents:FindFirstChild("DamagePlayer")

        if remote then
            remote:FireServer(-math.huge)
        end

    end)

end)


MainTab:AddToggle("自动击晕鹿 (Torch)", false, function(value)

    state.stunDeer = value

    if value then

        task.spawn(function()

            while state.stunDeer do

                pcall(function()

                    local characters =
                        workspace:FindFirstChild("Characters")

                    local deer =
                        characters and characters:FindFirstChild("Deer")

                    local remote =
                        ReplicatedStorage:FindFirstChild("RemoteEvents")
                        and ReplicatedStorage.RemoteEvents:FindFirstChild("MonsterHitByTorch")

                    if deer and remote then
                        remote:InvokeServer(deer)
                    end

                end)

                task.wait(0.5)

            end

        end)

    end

end)


MainTab:AddToggle("杀戮光环 (手持近战武器)", false, function(value)

    state.killAura = value

    if value then

        task.spawn(function()

            local ValidWeapons = {
                ["Old Axe"] = true,
                ["Good Axe"] = true,
                ["Spear"] = true,
                ["Hatchet"] = true,
                ["Strong Axe"] = true,
                ["Bone Club"] = true
            }

            while state.killAura do

                pcall(function()

                    local char = LocalPlayer.Character
                    local hrp =
                        char and char:FindFirstChild("HumanoidRootPart")

                    local toolHandle =
                        char and char:FindFirstChild("ToolHandle")

                    local attackRemote =
                        ReplicatedStorage:FindFirstChild("RemoteEvents")
                        and ReplicatedStorage.RemoteEvents:FindFirstChild("ToolDamageObject")

                    if not (hrp and toolHandle and attackRemote) then
                        return
                    end

                    local originalItem =
                        toolHandle:FindFirstChild("OriginalItem")

                    local currentTool =
                        originalItem and originalItem.Value

                    if not currentTool or not ValidWeapons[currentTool.Name] then
                        return
                    end

                    local chars =
                        workspace:FindFirstChild("Characters")

                    if not chars then
                        return
                    end

                    for _, enemy in ipairs(chars:GetChildren()) do

                        if enemy:IsA("Model")
                        and enemy:FindFirstChild("HumanoidRootPart")
                        and enemy:FindFirstChild("HitRegisters") then

                            local distance =
                                (hrp.Position - enemy.HumanoidRootPart.Position).Magnitude

                            if distance <= 100 then

                                attackRemote:InvokeServer(
                                    enemy,
                                    currentTool,
                                    true,
                                    hrp.CFrame
                                )

                            end

                        end

                    end

                end)

                task.wait(0.5)

            end

        end)

    end

end)


MainTab:AddToggle("范围自动砍树 (手持斧头)", false, function(value)

    state.autoChop = value

    if value then

        task.spawn(function()

            local ValidAxes = {
                ["Old Axe"] = true,
                ["Good Axe"] = true,
                ["Stone Axe"] = true,
                ["Iron Axe"] = true,
                ["Strong Axe"] = true
            }

            while state.autoChop do

                pcall(function()

                    local char = LocalPlayer.Character

                    local hrp =
                        char and char:FindFirstChild("HumanoidRootPart")

                    local toolHandle =
                        char and char:FindFirstChild("ToolHandle")

                    local chopRemote =
                        ReplicatedStorage:FindFirstChild("RemoteEvents")
                        and ReplicatedStorage.RemoteEvents:FindFirstChild("ToolDamageObject")

                    if not (hrp and toolHandle and chopRemote) then
                        return
                    end

                    local originalItem =
                        toolHandle:FindFirstChild("OriginalItem")

                    local currentTool =
                        originalItem and originalItem.Value

                    if not currentTool or not ValidAxes[currentTool.Name] then
                        return
                    end

                    local map =
                        workspace:FindFirstChild("Map")

                    if not map then
                        return
                    end

                    local folders = {
                        map:FindFirstChild("Foliage"),
                        map:FindFirstChild("Landmarks")
                    }

                    for _, folder in ipairs(folders) do

                        if folder then

                            for _, tree in ipairs(folder:GetChildren()) do

                                local validTree =
                                    tree.Name == "Small Tree"
                                    or tree.Name == "TreeBig1"
                                    or tree.Name == "TreeBig2"
                                    or tree.Name == "TreeBig3"

                                if tree:IsA("Model")
                                and validTree
                                and tree:FindFirstChild("HitRegisters") then

                                    local treePart =
                                        tree:FindFirstChild("Trunk")
                                        or tree:FindFirstChild("HumanoidRootPart")
                                        or tree.PrimaryPart

                                    if treePart then

                                        local distance =
                                            (hrp.Position - treePart.Position).Magnitude

                                        if distance <= 100 then

                                            chopRemote:InvokeServer(
                                                tree,
                                                currentTool,
                                                true,
                                                hrp.CFrame
                                            )

                                        end

                                    end

                                end

                            end

                        end

                    end

                end)

                task.wait(0.6)

            end

        end)

    end

end)

-- ==========================================================
-- 带来物资
-- ==========================================================

local function bringItem(itemName)

    pcall(function()

        local inventory =
            LocalPlayer:FindFirstChild("Inventory")

        local remotes =
            ReplicatedStorage:FindFirstChild("RemoteEvents")

        local itemsFolder =
            workspace:FindFirstChild("Items")

        if not (inventory and remotes and itemsFolder) then
            return
        end

        local storeRemote =
            remotes:FindFirstChild("RequestBagStoreItem")

        local dropRemote =
            remotes:FindFirstChild("RequestBagDropItem")

        if not (storeRemote and dropRemote) then
            return
        end

        for _, invItem in ipairs(inventory:GetChildren()) do

            for _, worldItem in ipairs(itemsFolder:GetChildren()) do

                if worldItem.Name == itemName then
                    storeRemote:InvokeServer(
                        invItem,
                        worldItem
                    )
                end

            end

        end

        task.wait(0.1)

        local target =
            itemsFolder:FindFirstChild(itemName)

        if target then

            for _, invItem in ipairs(inventory:GetChildren()) do

                dropRemote:FireServer(
                    invItem,
                    target,
                    true
                )

            end

        end

    end)

end


