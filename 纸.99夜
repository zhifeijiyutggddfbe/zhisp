-- 4. 🌱 圆圈种树 Tab
-- ==========================================================

PlantTab:AddButton("一键圆圈自动种树 (Sapling)", function()
    task.spawn(function()
        pcall(function()
            local remotes = ReplicatedStorage:FindFirstChild("RemoteEvents")
            local plantRemote = remotes and remotes:FindFirstChild("RequestPlantItem")
            local sapling = workspace:FindFirstChild("Items") and workspace.Items:FindFirstChild("Sapling")
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            if plantRemote and sapling and hrp then
                local radius = plantConfig.radius
                local angleStep = plantConfig.angleStep
                local fixedY = hrp.Position.Y

                for angle = 0, 350, angleStep do
                    local rad = math.rad(angle)
                    local pos = Vector3.new(
                        hrp.Position.X + radius * math.cos(rad),
                        fixedY,
                        hrp.Position.Z + radius * math.sin(rad)
                    )
                    plantRemote:InvokeServer(sapling, pos)
                    task.wait(0.1)
                end
            end
        end)
    end)
end)

