-- 3. 👁️ 透视显示 Tab
-- ==========================================================

ESPTab:AddToggle("透视所有生物 (Billboard)", false, function(val)
    state.espMonsters = val
    if val then
        task.spawn(function()
            while state.espMonsters do
                pcall(function()
                    local chars = workspace:FindFirstChild("Characters")
                    if chars then
                        for _, model in ipairs(chars:GetChildren()) do
                            if model:IsA("Model") and not model:FindFirstChild("ModelNameBillboard") then
                                local billboard = Instance.new("BillboardGui")
                                billboard.Name = "ModelNameBillboard"
                                billboard.Adornee = model
                                billboard.Size = UDim2.new(5, 0, 1, 0)
                                billboard.StudsOffset = Vector3.new(0, 3, 0)
                                billboard.AlwaysOnTop = true
                                billboard.MaxDistance = 1000000

                                local label = Instance.new("TextLabel")
                                label.Size = UDim2.new(1, 0, 1, 0)
                                label.BackgroundTransparency = 1
                                label.Text = model.Name
                                label.Font = Enum.Font.SourceSansBold
                                label.TextSize = 18
                                label.TextColor3 = Color3.fromRGB(255, 50, 50)
                                label.TextStrokeTransparency = 0.3
                                label.Parent = billboard

                                billboard.Parent = model
                            end
                        end
                    end
                end)
                task.wait(1)
            end
        end)
    else
        pcall(function()
            local chars = workspace:FindFirstChild("Characters")
            if chars then
                for _, model in ipairs(chars:GetChildren()) do
                    local bb = model:FindFirstChild("ModelNameBillboard")
                    if bb then bb:Destroy() end
                end
            end
        end)
    end
end)

