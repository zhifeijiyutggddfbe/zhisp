-- 杀戮光环 (需装备武器)
MainTab:AddToggle("杀戮光环 (手持近战武器)", false, function(val)
    state.killAura = val
    if val then
        task.spawn(function()
            local ValidWeapons = {["Old Axe"]=true, ["Good Axe"]=true, ["Spear"]=true, ["Hatchet"]=true, ["Strong Axe"]=true, ["Bone Club"]=true}
            while state.killAura do
                pcall(function()
                    local char = LocalPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    local toolHandle = char and char:FindFirstChild("ToolHandle")
                    local attackRemote = ReplicatedStorage:FindFirstChild("RemoteEvents") and ReplicatedStorage.RemoteEvents:FindFirstChild("ToolDamageObject")

                    if hrp and toolHandle and attackRemote then
                        local currentTool = toolHandle:FindFirstChild("OriginalItem") and toolHandle.OriginalItem.Value
                        if currentTool and ValidWeapons[currentTool.Name] then
                            local chars = workspace:FindFirstChild("Characters")
                            if chars then
                                for _, enemy in ipairs(chars:GetChildren()) do
                                    if enemy:IsA("Model") and enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("HitRegisters") then
                                        local dist = (hrp.Position - enemy.HumanoidRootPart.Position).Magnitude
                                        if dist <= 100 then
                                            attackRemote:InvokeServer(enemy, currentTool, true, hrp.CFrame)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end)
                task.wait(0.5)
            end
        end)
    end
end)

-- 范围自动砍树 (需装备斧头)
MainTab:AddToggle("范围自动砍树 (手持斧头)", false, function(val)
    state.autoChop = val
    if val then
        task.spawn(function()
            local ValidAxes = {["Old Axe"]=true, ["Good Axe"]=true, ["Stone Axe"]=true, ["Iron Axe"]=true, ["Strong Axe"]=true}
            while state.autoChop do
                pcall(function()
                    local char = LocalPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    local toolHandle = char and char:FindFirstChild("ToolHandle")
                    local chopRemote = ReplicatedStorage:FindFirstChild("RemoteEvents") and ReplicatedStorage.RemoteEvents:FindFirstChild("ToolDamageObject")

                    if hrp and toolHandle and chopRemote then
                        local currentTool = toolHandle:FindFirstChild("OriginalItem") and toolHandle.OriginalItem.Value
                        if currentTool and ValidAxes[currentTool.Name] then
                            local map = workspace:FindFirstChild("Map")
                            if map then
                                local treePaths = {map:FindFirstChild("Foliage"), map:FindFirstChild("Landmarks")}
                                for _, path in ipairs(treePaths) do
                                    if path then
                                        for _, tree in ipairs(path:GetChildren()) do
                                            local isValidTree = table.find({"Small Tree", "TreeBig1", "TreeBig2", "TreeBig3"}, tree.Name) ~= nil
                                            if tree:IsA("Model") and isValidTree and tree:FindFirstChild("HitRegisters") then
                                                local treePart = tree:FindFirstChild("Trunk") or tree:FindFirstChild("HumanoidRootPart") or tree.PrimaryPart
                                                if treePart and (hrp.Position - treePart.Position).Magnitude <= 100 then
                                                    chopRemote:InvokeServer(tree, currentTool, true, hrp.CFrame)
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end)
                task.wait(0.6)
            end
        end)
    end
end)

