-- 2. 📦 带来物资 Tab
-- ==========================================================

local function bringItem(itemName)
    pcall(function()
        local inventory = LocalPlayer:FindFirstChild("Inventory")
        local remotes = ReplicatedStorage:FindFirstChild("RemoteEvents")
        local itemsFolder = workspace:FindFirstChild("Items")
        if not (inventory and remotes and itemsFolder) then return end

        local storeRemote = remotes:FindFirstChild("RequestBagStoreItem")
        local dropRemote = remotes:FindFirstChild("RequestBagDropItem")
        if not (storeRemote and dropRemote) then return end

        -- 1. 放入背包
        for _, invItem in ipairs(inventory:GetChildren()) do
            for _, worldItem in ipairs(itemsFolder:GetChildren()) do
                if worldItem.Name == itemName then
                    storeRemote:InvokeServer(invItem, worldItem)
                end
            end
        end

        task.wait(0.1)

        -- 2. 丢出背包到脚下
        local targetWorldItem = itemsFolder:FindFirstChild(itemName)
        if targetWorldItem then
            for _, invItem in ipairs(inventory:GetChildren()) do
                dropRemote:FireServer(invItem, targetWorldItem, true)
            end
        end
    end)
end

