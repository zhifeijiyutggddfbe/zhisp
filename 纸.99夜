-- ==========================================================
-- 透视
-- ==========================================================

local function createESP(model)

    if not model:IsA("Model") then
        return
    end

    if model:FindFirstChild("ModelNameBillboard") then
        return
    end

    local billboard = Instance.new("BillboardGui")

    billboard.Name = "ModelNameBillboard"
    billboard.Adornee = model
    billboard.Size = UDim2.new(5, 0, 1, 0)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 1000000

    local label = Instance.new("TextLabel")

    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = model.Name
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 18
    label.TextColor3 = Color3.fromRGB(255, 50, 50)
    label.TextStrokeTransparency = 0.3
    label.Parent = billboard

    billboard.Parent = model

end


local function clearESP()

    local chars =
        workspace:FindFirstChild("Characters")

    if not chars then
        return
    end

    for _, model in ipairs(chars:GetChildren()) do

        local billboard =
            model:FindFirstChild("ModelNameBillboard")

        if billboard then
            billboard:Destroy()
        end

    end

end


ESPTab:AddToggle("透视所有生物 (Billboard)", false, function(value)

    state.espMonsters = value

    if value then

        task.spawn(function()

            while state.espMonsters do

                pcall(function()

                    local chars =
                        workspace:FindFirstChild("Characters")

                    if chars then

                        for _, model in ipairs(chars:GetChildren()) do
                            createESP(model)
                        end

                    end

                end)

                task.wait(1)

            end

        end)

    else

        clearESP()

    end

end)

-- ==========================================================
-- 圆圈种树
-- ==========================================================

PlantTab:AddButton("一键圆圈自动种树 (Sapling)", function()

    task.spawn(function()

        pcall(function()

            local remotes =
                ReplicatedStorage:FindFirstChild("RemoteEvents")

            local plantRemote =
                remotes and remotes:FindFirstChild("RequestPlantItem")

            local sapling =
                workspace:FindFirstChild("Items")
                and workspace.Items:FindFirstChild("Sapling")

            local char =
                LocalPlayer.Character

            local hrp =
                char and char:FindFirstChild("HumanoidRootPart")

            if not (plantRemote and sapling and hrp) then
                return
            end

            local radius = plantConfig.radius
            local angleStep = plantConfig.angleStep
            local fixedY = hrp.Position.Y

            for angle = 0, 350, angleStep do

                local rad = math.rad(angle)

                local pos = Vector3.new(
                    hrp.Position.X + radius * math.cos(rad),
                    fixedY,
                    hrp.Position.Z + radius * math.sin(rad)
                )

                plantRemote:InvokeServer(
                    sapling,
                    pos
                )

                task.wait(0.1)

            end

        end)

    end)

end)

